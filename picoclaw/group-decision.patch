+// recordSentMessage tells a SentMessageRecorder channel about a delivered message.
+func recordSentMessage(ch Channel, msg bus.OutboundMessage, messageIDs []string) {
+	recorder, ok := ch.(SentMessageRecorder)
+	if !ok || len(messageIDs) == 0 || outboundMessageIsToolFeedback(msg) {
+		return
+	}
+	recorder.RecordSentMessage(msg.ChatID, &msg.Context, msg.Content, messageIDs)
+}
+
+// recordSentMediaMessage tells a SentMessageRecorder channel about delivered
+// media. The recorded text is the captions, or the kind of the first attachment.
+func recordSentMediaMessage(ch Channel, msg bus.OutboundMediaMessage, messageIDs []string) {
+	recorder, ok := ch.(SentMessageRecorder)
+	if !ok || len(messageIDs) == 0 || len(msg.Parts) == 0 {
+		return
+	}
+	var captions []string
+	for _, part := range msg.Parts {
+		if part.Caption != "" {
+			captions = append(captions, part.Caption)
+		}
+	}
+	content := strings.Join(captions, "\n")
+	if content == "" {
+		content = "[" + msg.Parts[0].Type + "]"
+	}
+	recorder.RecordSentMessage(msg.ChatID, &msg.Context, content, messageIDs)
+}
