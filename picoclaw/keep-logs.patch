+// archivePath is the session's append-only copy in the archive/ subdirectory.
+// Compact, SetHistory and alias promotion rewrite the live .jsonl and drop
+// old messages; nothing ever rewrites or truncates the archive, so the full
+// conversation stays on disk for later bug analysis.
+func (s *JSONLStore) archivePath(key string) string {
+	return filepath.Join(s.dir, "archive", sanitizeKey(key)+".jsonl")
+}
+
+// appendArchive appends one encoded message line to the session's archive.
+func (s *JSONLStore) appendArchive(key string, line []byte) error {
+	path := s.archivePath(key)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return fmt.Errorf("memory: create archive dir: %w", err)
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		return fmt.Errorf("memory: open archive: %w", err)
+	}
+	if _, err := f.Write(line); err != nil {
+		f.Close()
+		return fmt.Errorf("memory: append archive: %w", err)
+	}
+	// Same durability as the live file: an unsynced line lost on power-off
+	// would leave a permanent gap once the live file is compacted.
+	if err := f.Sync(); err != nil {
+		f.Close()
+		return fmt.Errorf("memory: sync archive: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("memory: close archive: %w", err)
+	}
+	return nil
+}
+
 func (s *JSONLStore) metaPath(key string) string {
 	return filepath.Join(s.dir, sanitizeKey(key)+".meta.json")
 }
