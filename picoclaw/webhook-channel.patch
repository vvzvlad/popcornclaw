+func TestWebhookHandler_PublishesInboundMessage(t *testing.T) {
+	ch, mb := newTestChannel(t, &config.WebhookSettings{
+		Secret:  *config.NewSecureString(testSecret),
+		SendURL: "http://127.0.0.1/send",
+	})
+	ch.SetName("zakhar")
+
+	body := []byte(`{"sender":"alice","content":"hello","thread_id":"t1"}`)
+	req := httptest.NewRequest(http.MethodPost, "/webhook/zakhar", bytes.NewReader(body))
+	req.Header.Set(signatureHeader, sign(testSecret, body))
+	rec := httptest.NewRecorder()
+
+	ch.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusAccepted, rec.Code)
+
+	select {
+	case msg := <-mb.InboundChan():
+		assert.Equal(t, "hello", msg.Content)
+		assert.Equal(t, "zakhar", msg.Context.Channel)
+		assert.Equal(t, "t1", msg.Context.ChatID)
+		assert.Equal(t, "direct", msg.Context.ChatType)
+		assert.Equal(t, "alice", msg.Context.SenderID)
+		assert.Equal(t, "webhook:alice", msg.Sender.CanonicalID)
+	case <-time.After(5 * time.Second):
+		t.Fatal("inbound message was not published")
+	}
+}
