diff --git a/pkg/channels/webhook/init.go b/pkg/channels/webhook/init.go
new file mode 100644
index 00000000..2743379a
--- /dev/null
+++ b/pkg/channels/webhook/init.go
@@ -0,0 +1,32 @@
+package webhook
+
+import (
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/channels"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+func init() {
+	channels.RegisterFactory(
+		config.ChannelWebhook,
+		func(channelName, channelType string, cfg *config.Config, b *bus.MessageBus) (channels.Channel, error) {
+			bc := cfg.Channels[channelName]
+			decoded, err := bc.GetDecoded()
+			if err != nil {
+				return nil, err
+			}
+			c, ok := decoded.(*config.WebhookSettings)
+			if !ok {
+				return nil, channels.ErrSendFailed
+			}
+			ch, err := NewWebhookChannel(bc, c, b)
+			if err != nil {
+				return nil, err
+			}
+			if channelName != config.ChannelWebhook {
+				ch.SetName(channelName)
+			}
+			return ch, nil
+		},
+	)
+}
diff --git a/pkg/channels/webhook/webhook.go b/pkg/channels/webhook/webhook.go
new file mode 100644
index 00000000..74710a69
--- /dev/null
+++ b/pkg/channels/webhook/webhook.go
@@ -0,0 +1,280 @@
+package webhook
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/channels"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/identity"
+	"github.com/sipeed/picoclaw/pkg/logger"
+	"github.com/sipeed/picoclaw/pkg/utils"
+)
+
+const (
+	signatureHeader = "X-Webhook-Signature"
+	signaturePrefix = "sha256="
+
+	sendTimeout    = 30 * time.Second
+	publishTimeout = 5 * time.Second
+
+	// Limit request body to prevent memory exhaustion (DoS).
+	maxWebhookBodySize = 1 << 20 // 1 MiB
+)
+
+// inboundPayload is the JSON body of an incoming webhook request.
+type inboundPayload struct {
+	Sender   string `json:"sender"`
+	Content  string `json:"content"`
+	ThreadID string `json:"thread_id"`
+}
+
+// outboundPayload is the JSON body of a reply posted to the send URL.
+type outboundPayload struct {
+	Content   string `json:"content"`
+	ThreadID  string `json:"thread_id"`
+	Recipient string `json:"recipient"`
+}
+
+// WebhookChannel implements the Channel interface for a generic HMAC-signed
+// webhook: messages arrive as signed POST requests on the shared HTTP server
+// and every reply is POSTed as JSON to the configured send URL. The thread ID
+// of a request is used as the chat ID.
+type WebhookChannel struct {
+	*channels.BaseChannel
+	config *config.WebhookSettings
+	client *http.Client
+}
+
+// NewWebhookChannel creates a new webhook channel instance.
+func NewWebhookChannel(
+	bc *config.Channel,
+	cfg *config.WebhookSettings,
+	messageBus *bus.MessageBus,
+) (*WebhookChannel, error) {
+	if cfg.Secret.String() == "" || cfg.SendURL == "" {
+		return nil, fmt.Errorf("webhook secret and send_url are required")
+	}
+
+	base := channels.NewBaseChannel(
+		config.ChannelWebhook, cfg, messageBus, bc.AllowFrom,
+		channels.WithReasoningChannelID(bc.ReasoningChannelID),
+	)
+
+	return &WebhookChannel{
+		BaseChannel: base,
+		config:      cfg,
+		client:      &http.Client{Timeout: sendTimeout},
+	}, nil
+}
+
+// Start initializes the webhook channel.
+func (c *WebhookChannel) Start(ctx context.Context) error {
+	logger.InfoCF("webhook", "Starting webhook channel", map[string]any{
+		"channel": c.Name(),
+		"path":    c.WebhookPath(),
+	})
+
+	c.SetRunning(true)
+	return nil
+}
+
+// Stop gracefully stops the webhook channel.
+func (c *WebhookChannel) Stop(ctx context.Context) error {
+	logger.InfoCF("webhook", "Stopping webhook channel", map[string]any{"channel": c.Name()})
+	c.SetRunning(false)
+	return nil
+}
+
+// WebhookPath returns the path for registering on the shared HTTP server.
+func (c *WebhookChannel) WebhookPath() string {
+	if c.config.Path != "" {
+		return c.config.Path
+	}
+	return "/webhook/" + c.Name()
+}
+
+// ServeHTTP implements http.Handler for the shared HTTP server.
+func (c *WebhookChannel) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	c.webhookHandler(w, r)
+}
+
+// webhookHandler handles incoming webhook requests.
+func (c *WebhookChannel) webhookHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	if !c.IsRunning() {
+		http.Error(w, "Service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+
+	body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxWebhookBodySize))
+	if err != nil {
+		var maxBytesErr *http.MaxBytesError
+		if errors.As(err, &maxBytesErr) {
+			logger.WarnCF("webhook", "Webhook request body too large, rejected", map[string]any{
+				"channel": c.Name(),
+			})
+			http.Error(w, "Request entity too large", http.StatusRequestEntityTooLarge)
+		} else {
+			http.Error(w, "Bad request", http.StatusBadRequest)
+		}
+		return
+	}
+
+	if !validSignature(c.config.Secret.String(), body, r.Header.Get(signatureHeader)) {
+		logger.WarnCF("webhook", "Invalid webhook signature", map[string]any{
+			"channel": c.Name(),
+		})
+		http.Error(w, "Unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	var payload inboundPayload
+	if err := json.Unmarshal(body, &payload); err != nil || strings.TrimSpace(payload.Content) == "" {
+		http.Error(w, "Bad request", http.StatusBadRequest)
+		return
+	}
+
+	// The thread is the chat; a request without one falls back to its sender.
+	senderID := strings.TrimSpace(payload.Sender)
+	chatID := strings.TrimSpace(payload.ThreadID)
+	if chatID == "" {
+		chatID = senderID
+	}
+	if chatID == "" {
+		http.Error(w, "Bad request", http.StatusBadRequest)
+		return
+	}
+
+	sender := bus.SenderInfo{
+		Platform:    config.ChannelWebhook,
+		PlatformID:  senderID,
+		CanonicalID: identity.BuildCanonicalID(config.ChannelWebhook, senderID),
+	}
+	if !c.IsAllowedSender(sender) {
+		http.Error(w, "Forbidden", http.StatusForbidden)
+		return
+	}
+
+	logger.DebugCF("webhook", "Received message", map[string]any{
+		"channel":   c.Name(),
+		"sender_id": senderID,
+		"chat_id":   chatID,
+		"preview":   utils.Truncate(payload.Content, 50),
+	})
+
+	inboundCtx := bus.InboundContext{
+		Channel:  c.Name(),
+		ChatID:   chatID,
+		ChatType: "direct",
+		SenderID: senderID,
+		Raw: map[string]string{
+			"platform": config.ChannelWebhook,
+		},
+	}
+
+	// The caller treats any non-2xx answer as "not delivered", so the status
+	// reflects whether the message actually reached the agent.
+	ctx, cancel := context.WithTimeout(r.Context(), publishTimeout)
+	defer cancel()
+	if err := c.HandleInboundContext(ctx, chatID, payload.Content, nil, inboundCtx, sender); err != nil {
+		logger.ErrorCF("webhook", "Failed to publish inbound message", map[string]any{
+			"channel": c.Name(),
+			"chat_id": chatID,
+			"error":   err.Error(),
+		})
+		http.Error(w, "Service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+
+	w.WriteHeader(http.StatusAccepted)
+}
+
+// Send posts a reply to the configured send URL. Tool-feedback messages are
+// dropped, since the receiver handles every POST as a reply to the user.
+func (c *WebhookChannel) Send(ctx context.Context, msg bus.OutboundMessage) ([]string, error) {
+	if !c.IsRunning() {
+		return nil, channels.ErrNotRunning
+	}
+
+	if outboundMessageIsToolFeedback(msg) {
+		return nil, nil
+	}
+
+	jsonData, err := json.Marshal(outboundPayload{
+		Content:   msg.Content,
+		ThreadID:  msg.ChatID,
+		Recipient: msg.ChatID,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("webhook: failed to marshal payload: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.config.SendURL, bytes.NewReader(jsonData))
+	if err != nil {
+		return nil, fmt.Errorf("webhook: failed to create request: %w: %w", channels.ErrSendFailed, err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.client.Do(req)
+	if err != nil {
+		logger.ErrorCF("webhook", "Failed to send message", map[string]any{
+			"channel": c.Name(),
+			"chat_id": msg.ChatID,
+			"error":   err.Error(),
+		})
+		return nil, fmt.Errorf("webhook: network error: %w", channels.ClassifyNetError(err))
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode >= http.StatusBadRequest {
+		sendErr := fmt.Errorf("status %d", resp.StatusCode)
+		logger.ErrorCF("webhook", "Send URL rejected message", map[string]any{
+			"channel": c.Name(),
+			"chat_id": msg.ChatID,
+			"error":   sendErr.Error(),
+		})
+		return nil, fmt.Errorf("webhook: %w", channels.ClassifySendError(resp.StatusCode, sendErr))
+	}
+
+	return nil, nil
+}
+
+// validSignature reports whether header carries the hex HMAC-SHA256 of body
+// under secret, in the form "sha256=<hex>".
+func validSignature(secret string, body []byte, header string) bool {
+	sig, ok := strings.CutPrefix(header, signaturePrefix)
+	if !ok {
+		return false
+	}
+	got, err := hex.DecodeString(sig)
+	if err != nil {
+		return false
+	}
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write(body)
+	return hmac.Equal(got, mac.Sum(nil))
+}
+
+// outboundMessageIsToolFeedback reports whether msg is a tool-feedback progress message.
+func outboundMessageIsToolFeedback(msg bus.OutboundMessage) bool {
+	if len(msg.Context.Raw) == 0 {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(msg.Context.Raw["message_kind"]), "tool_feedback")
+}
