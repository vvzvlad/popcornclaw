+++ b/pkg/channels/group_decision_test.go
@@ -0,0 +1,165 @@
+package channels
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+func TestGroupHistory_RecentReturnsLastMessagesInOrder(t *testing.T) {
+	h := NewGroupHistory()
+	now := time.Now()
+	for i := 1; i <= GroupHistoryMaxMessages+3; i++ {
+		h.Add("chat", GroupHistoryEntry{MessageID: i, From: "u", Text: fmt.Sprint(i), Time: now})
+	}
+
+	got := h.Recent("chat", 1000, now)
+	if len(got) != GroupHistoryMaxMessages {
+		t.Fatalf("len = %d, want %d", len(got), GroupHistoryMaxMessages)
+	}
+	for i, e := range got {
+		if want := fmt.Sprint(i + 4); e.Text != want {
+			t.Fatalf("entry %d = %q, want %q (oldest first)", i, e.Text, want)
+		}
+	}
+}
+
+func TestGroupHistory_RecentDropsMessagesOlderThanWindow(t *testing.T) {
+	h := NewGroupHistory()
+	now := time.Now()
+	h.Add("chat", GroupHistoryEntry{MessageID: 1, From: "u", Text: "old", Time: now.Add(-GroupHistoryWindow - time.Second)})
+	h.Add("chat", GroupHistoryEntry{MessageID: 2, From: "u", Text: "edge", Time: now.Add(-GroupHistoryWindow)})
+	h.Add("chat", GroupHistoryEntry{MessageID: 3, From: "u", Text: "new", Time: now.Add(-time.Minute)})
+
+	got := h.Recent("chat", 1000, now)
+	if len(got) != 2 || got[0].Text != "edge" || got[1].Text != "new" {
+		t.Fatalf("Recent = %+v, want [edge new]", got)
+	}
+	if got := h.Recent("other chat", 1000, now); len(got) != 0 {
+		t.Fatalf("unknown chat has history: %+v", got)
+	}
+}
+
+func TestGroupHistory_OrdersByMessageIDWhateverTheArrival(t *testing.T) {
+	h := NewGroupHistory()
+	now := time.Now()
+	for _, id := range []int{30, 10, 40, 20} {
+		h.Add("chat", GroupHistoryEntry{MessageID: id, From: "u", Text: fmt.Sprint(id), Time: now})
+	}
+
+	ids := func(entries []GroupHistoryEntry) string {
+		var out []int
+		for _, e := range entries {
+			out = append(out, e.MessageID)
+		}
+		return fmt.Sprint(out)
+	}
+	if got := ids(h.Recent("chat", 1000, now)); got != "[10 20 30 40]" {
+		t.Errorf("all = %s, want [10 20 30 40]", got)
+	}
+	if got := ids(h.Recent("chat", 30, now)); got != "[10 20]" {
+		t.Errorf("before 30 = %s, want [10 20]", got)
+	}
+	if got := ids(h.Recent("chat", 10, now)); got != "[]" {
+		t.Errorf("before 10 = %s, want none", got)
+	}
+
+	h.Add("chat", GroupHistoryEntry{MessageID: 20, From: "u", Text: "edited", Time: now})
+	if got := h.Recent("chat", 30, now); len(got) != 2 || got[1].Text != "edited" {
+		t.Errorf("the same message ID added twice: %+v, want it replaced", got)
+	}
+}
+
+func TestGroupHistory_StorageCapDropsTheOldestIDs(t *testing.T) {
+	h := NewGroupHistory()
+	now := time.Now()
+	for _, id := range []int{500, 100} {
+		h.Add("chat", GroupHistoryEntry{MessageID: id, From: "u", Time: now})
+	}
+	for i := 0; i < groupHistoryStored; i++ {
+		h.Add("chat", GroupHistoryEntry{MessageID: 200 + i, From: "u", Time: now})
+	}
+
+	got := h.Recent("chat", 1000, now)
+	if got[len(got)-1].MessageID != 500 || len(got) != GroupHistoryMaxMessages {
+		t.Fatalf("Recent = %+v, want the latest %d ending with 500", got, GroupHistoryMaxMessages)
+	}
+	h.mu.Lock()
+	stored := len(h.chats["chat"].entries)
+	h.mu.Unlock()
+	if stored != groupHistoryStored {
+		t.Fatalf("%d messages stored, want the cap %d", stored, groupHistoryStored)
+	}
+}
+
+func TestGroupHistory_LastBotSurvivesCapAndWindow(t *testing.T) {
+	h := NewGroupHistory()
+	now := time.Now()
+	if _, ok := h.LastBot("chat", 1000); ok {
+		t.Fatal("LastBot on empty history")
+	}
+	h.Add("chat", GroupHistoryEntry{MessageID: 1, From: GroupHistoryBotName, Text: "first", Time: now.Add(-3 * time.Hour)})
+	h.Add("chat", GroupHistoryEntry{MessageID: 2, From: GroupHistoryBotName, Text: "second", Time: now.Add(-2 * time.Hour)})
+	for i := 0; i < groupHistoryStored; i++ {
+		h.Add("chat", GroupHistoryEntry{MessageID: 10 + i, From: "u", Text: "x", Time: now})
+	}
+
+	got, ok := h.LastBot("chat", 1000)
+	if !ok || got.Text != "second" {
+		t.Fatalf("LastBot = %+v, %v; want the second bot message", got, ok)
+	}
+	if got, ok := h.LastBot("chat", 2); !ok || got.Text != "first" {
+		t.Fatalf("LastBot before 2 = %+v, %v; want the first bot message", got, ok)
+	}
+	if _, ok := h.LastBot("chat", 1); ok {
+		t.Fatal("LastBot before the first bot message")
+	}
+	for _, e := range h.Recent("chat", 1000, now) {
+		if e.From == GroupHistoryBotName {
+			t.Fatalf("bot message left in recent history: %+v", e)
+		}
+	}
+}
+
+type fakeDecider struct {
+	p   float64
+	err error
+}
+
+func (f fakeDecider) ReplyProbability(context.Context, GroupReplyRequest) (float64, error) {
+	return f.p, f.err
+}
+
+func TestShouldRespondByDecision(t *testing.T) {
+	tests := []struct {
+		name      string
+		minConf   float64
+		decider   fakeDecider
+		wantReply bool
+	}{
+		{"above default threshold", 0, fakeDecider{p: 0.6}, true},
+		{"exactly the default threshold", 0, fakeDecider{p: 0.5}, true},
+		{"below default threshold", 0, fakeDecider{p: 0.49}, false},
+		{"configured threshold met", 0.8, fakeDecider{p: 0.8}, true},
+		{"configured threshold missed", 0.8, fakeDecider{p: 0.79}, false},
+		{"error is ignored", 0, fakeDecider{p: 1, err: errors.New("boom")}, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ch := NewBaseChannel("test", nil, bus.NewMessageBus(), []string{"*"},
+				WithGroupTrigger(config.GroupTriggerConfig{
+					Decision: config.GroupDecisionConfig{MinConfidence: tc.minConf},
+				}),
+			)
+			ch.SetGroupDecider(tc.decider)
+			if got := ch.ShouldRespondByDecision(context.Background(), "chat", GroupReplyRequest{}); got != tc.wantReply {
+				t.Fatalf("respond = %v, want %v", got, tc.wantReply)
+			}
+		})
+	}
+}
