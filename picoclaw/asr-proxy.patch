+// The ASR model's proxy must be used like the LLM providers use theirs: Groq refuses requests
+// from some regions, and the transcriber used to go direct regardless of model_list proxy.
+func TestNewWhisperTranscriberUsesModelProxy(t *testing.T) {
+	tr := NewWhisperTranscriber(&config.ModelConfig{
+		Model: "groq/whisper-large-v3-turbo",
+		Proxy: "socks5://10.0.0.1:1080",
+	})
+	if tr == nil {
+		t.Fatal("NewWhisperTranscriber returned nil")
+	}
+	transport, ok := tr.httpClient.Transport.(*http.Transport)
+	if !ok || transport.Proxy == nil {
+		t.Fatalf("transcriber transport has no proxy: %#v", tr.httpClient.Transport)
+	}
+	req := httptest.NewRequest(http.MethodPost, "https://api.groq.com/openai/v1/audio/transcriptions", nil)
+	got, err := transport.Proxy(req)
+	if err != nil || got == nil || got.String() != "socks5://10.0.0.1:1080" {
+		t.Fatalf("proxy for transcription request = %v, %v; want socks5://10.0.0.1:1080", got, err)
+	}
+}
