+// setOwnCommands records the names and aliases of this bot's commands.
+func (c *TelegramChannel) setOwnCommands(defs []commands.Definition) {
+	names := make(map[string]struct{}, len(defs))
+	for _, def := range defs {
+		if def.Name != "" {
+			names[strings.ToLower(def.Name)] = struct{}{}
+		}
+		for _, alias := range def.Aliases {
+			if alias != "" {
+				names[strings.ToLower(alias)] = struct{}{}
+			}
+		}
+	}
+	c.ownCommandsMu.Lock()
+	c.ownCommands = names
+	c.ownCommandsMu.Unlock()
+}
+
+// isOwnCommand reports whether name is one of this bot's registered commands.
+func (c *TelegramChannel) isOwnCommand(name string) bool {
+	c.ownCommandsMu.RLock()
+	defer c.ownCommandsMu.RUnlock()
+	_, ok := c.ownCommands[strings.ToLower(name)]
+	return ok
+}
