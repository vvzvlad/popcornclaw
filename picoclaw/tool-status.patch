+// ToolStatusArg is the required argument added to every tool schema sent to the
+// LLM. The model fills it with a short phrase shown in chat as the tool feedback
+// status; it is stripped from the arguments before the tool runs.
+const ToolStatusArg = "status"
+
+const toolStatusDescription = "Одна короткая фраза по-русски для пользователя: что ты сейчас делаешь и зачем, на каком ты этапе. Показывается в чате как статус. Не команда и не аргументы."
+
+// withToolStatusParam returns a copy of params with the required status argument
+// added, leaving the tool's own schema untouched.
+func withToolStatusParam(params map[string]any) map[string]any {
+	out := make(map[string]any, len(params)+2)
+	for k, v := range params {
+		out[k] = v
+	}
+	props := map[string]any{}
+	if existing, ok := params["properties"].(map[string]any); ok {
+		for k, v := range existing {
+			props[k] = v
+		}
+	}
+	props[ToolStatusArg] = map[string]any{
+		"type":        "string",
+		"description": toolStatusDescription,
+	}
+	out["properties"] = props
+	switch required := params["required"].(type) {
+	case []string:
+		out["required"] = append(append([]string{}, required...), ToolStatusArg)
+	case []any:
+		out["required"] = append(append([]any{}, required...), ToolStatusArg)
+	default:
+		out["required"] = []string{ToolStatusArg}
+	}
+	return out
+}
+
+// StripToolStatus removes the status argument from args so tools never receive it.
+func StripToolStatus(args map[string]any) {
+	delete(args, ToolStatusArg)
+}
