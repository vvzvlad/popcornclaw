diff --git a/pkg/agent/shared_dialog.go b/pkg/agent/shared_dialog.go
new file mode 100644
index 0000000..3cf84d7
--- /dev/null
+++ b/pkg/agent/shared_dialog.go
@@ -0,0 +1,93 @@
+package agent
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/logger"
+)
+
+// The TV (a pico client) and the owner's Telegram DM (or a Telegram group) are one dialog when
+// session.identity_links joins them. A TV message becomes a message of that chat: it shares the chat's
+// session and its turns, a message in the middle of a turn is steered into it as in Telegram, and the
+// turn answers in the chat as usual while the channel manager mirrors the chat's text (not its files) to
+// the TV. Each side also sees the owner's messages typed on the other one, and the TV is told when a
+// turn is over.
+
+const (
+	messageKindUser    = "user"     // the owner's message, shown in the other chats of the dialog
+	messageKindTurnEnd = "turn_end" // the dialog's turn is over
+)
+
+// joinLinkedChat turns a pico message from a chat linked to a Telegram chat into a message of that chat.
+// Its sender stays the pico one, which tells where the message was typed. The linked chat may be a
+// group as well as a DM: Telegram group ids are negative, and a group message's session is keyed by
+// the "group" chat type, so the TV's message must carry it to land in the group's session.
+func (al *AgentLoop) joinLinkedChat(msg bus.InboundMessage) bus.InboundMessage {
+	if msg.Channel != "pico" {
+		return msg
+	}
+	for _, c := range al.GetConfig().Session.LinkedChats(msg.Channel, msg.ChatID) {
+		if c.Channel == "telegram" {
+			chatType := "direct"
+			if strings.HasPrefix(c.ChatID, "-") {
+				chatType = "group"
+			}
+			return bus.NormalizeInboundMessage(bus.InboundMessage{
+				Context:    bus.InboundContext{Channel: c.Channel, ChatID: c.ChatID, ChatType: chatType, SenderID: c.ChatID},
+				Sender:     msg.Sender,
+				Content:    msg.Content,
+				Media:      msg.Media,
+				MediaScope: msg.MediaScope,
+			})
+		}
+	}
+	return msg
+}
+
+// echoToLinkedChats shows the owner's message in the other chats of its dialog: a TV message in the
+// linked Telegram chat as "📺 <text>", a Telegram message on the TV.
+func (al *AgentLoop) echoToLinkedChats(ctx context.Context, msg bus.InboundMessage) {
+	fromTV := msg.Sender.Platform == "pico" && msg.Channel != "pico"
+	for _, c := range al.GetConfig().Session.LinkedChats(msg.Channel, msg.ChatID) {
+		ownChat := c.Channel == msg.Channel && c.ChatID == msg.ChatID
+		if ownChat != fromTV {
+			continue // the chat the message was typed in
+		}
+		content := msg.Content
+		if fromTV {
+			content = "📺 " + content
+		}
+		al.publishToLinkedChat(ctx, c, messageKindUser, content)
+	}
+}
+
+// endLinkedTurn tells the TV that msg's turn is over, whatever ended it: an answer, an error, /stop or
+// an answer sent with the message tool.
+func (al *AgentLoop) endLinkedTurn(ctx context.Context, msg bus.InboundMessage) {
+	for _, c := range al.GetConfig().Session.LinkedChats(msg.Channel, msg.ChatID) {
+		if c.Channel == "pico" {
+			al.publishToLinkedChat(ctx, c, messageKindTurnEnd, "")
+		}
+	}
+}
+
+func (al *AgentLoop) publishToLinkedChat(ctx context.Context, c config.LinkedChat, kind, content string) {
+	pubCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	err := al.bus.PublishOutbound(pubCtx, bus.OutboundMessage{
+		Context: bus.InboundContext{
+			Channel: c.Channel,
+			ChatID:  c.ChatID,
+			Raw:     map[string]string{metadataKeyMessageKind: kind},
+		},
+		Content: content,
+	})
+	if err != nil {
+		logger.WarnCF("agent", "Failed to publish to a linked chat",
+			map[string]any{"channel": c.Channel, "chat_id": c.ChatID, "kind": kind, "error": err.Error()})
+	}
+}
diff --git a/pkg/agent/shared_dialog_test.go b/pkg/agent/shared_dialog_test.go
new file mode 100644
index 0000000..625f1cd
--- /dev/null
+++ b/pkg/agent/shared_dialog_test.go
@@ -0,0 +1,229 @@
+package agent
+
+import (
+	"context"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/providers"
+)
+
+// The owner's Telegram DM session on the box: v=1|agent=main|channel=telegram|account=default|chat=direct:11111111.
+const ownerDMKey = "sk_v1_bd60789427ad9577ade505cafb5f771d7d4107adb48458ad1d326f5ce7e89556"
+
+// dialogProvider answers in order; with hold set, its first call waits until hold is closed.
+type dialogProvider struct {
+	mu           sync.Mutex
+	answers      []string
+	calls        [][]providers.Message
+	firstStarted chan struct{}
+	hold         chan struct{}
+}
+
+func (p *dialogProvider) Chat(
+	ctx context.Context,
+	messages []providers.Message,
+	tools []providers.ToolDefinition,
+	model string,
+	opts map[string]any,
+) (*providers.LLMResponse, error) {
+	p.mu.Lock()
+	p.calls = append(p.calls, append([]providers.Message(nil), messages...))
+	call := len(p.calls)
+	p.mu.Unlock()
+	if call == 1 && p.hold != nil {
+		close(p.firstStarted)
+		<-p.hold
+	}
+	return &providers.LLMResponse{Content: p.answers[call-1]}, nil
+}
+
+func (p *dialogProvider) GetDefaultModel() string { return "dialog-mock" }
+
+// A Telegram group: v=1|agent=main|channel=telegram|account=default|chat=group:-1009876543.
+const ownerGroupKey = "sk_v1_4acc457bb9ce2c4b7e9f17b36f9e25409e07af2e5891e40c08ce6d97df13fb44"
+
+func startDialogLoop(t *testing.T, provider *dialogProvider) (*AgentLoop, *bus.MessageBus) {
+	return startLinkedDialogLoop(t, provider, "telegram:11111111")
+}
+
+// startLinkedDialogLoop links the TV to the given Telegram chat, as session.identity_links does on the box.
+func startLinkedDialogLoop(t *testing.T, provider *dialogProvider, telegramChat string) (*AgentLoop, *bus.MessageBus) {
+	t.Helper()
+	cfg := &config.Config{
+		Agents: config.AgentsConfig{
+			Defaults: config.AgentDefaults{
+				Workspace:         t.TempDir(),
+				ModelName:         "test-model",
+				MaxTokens:         4096,
+				MaxToolIterations: 10,
+			},
+		},
+		// As config.json on the box loads (the chat dimension is LoadConfig's default).
+		Session: config.SessionConfig{
+			Dimensions:    []string{"chat"},
+			IdentityLinks: map[string][]string{"owner": {telegramChat, "pico:tv"}},
+		},
+	}
+	msgBus := bus.NewMessageBus()
+	al := NewAgentLoop(cfg, msgBus, provider)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	go al.Run(ctx)
+	return al, msgBus
+}
+
+func publishInbound(t *testing.T, msgBus *bus.MessageBus, msg bus.InboundMessage) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err := msgBus.PublishInbound(ctx, msg); err != nil {
+		t.Fatalf("publish %q: %v", msg.Content, err)
+	}
+}
+
+// As the pico and Telegram channels deliver them.
+func tvMessage(text string) bus.InboundMessage {
+	return bus.InboundMessage{
+		Context: bus.InboundContext{Channel: "pico", ChatID: "pico:tv", ChatType: "direct", SenderID: "pico-user"},
+		Sender:  bus.SenderInfo{Platform: "pico", PlatformID: "pico-user", CanonicalID: "pico:pico-user"},
+		Content: text,
+	}
+}
+
+func dmMessage(text string) bus.InboundMessage {
+	return bus.InboundMessage{
+		Context: bus.InboundContext{Channel: "telegram", ChatID: "11111111", ChatType: "direct", SenderID: "11111111"},
+		Sender:  bus.SenderInfo{Platform: "telegram", PlatformID: "11111111", CanonicalID: "telegram:11111111"},
+		Content: text,
+	}
+}
+
+type sent struct{ channel, chatID, kind, content string }
+
+// sentUntilTurnEnd collects outbound messages up to the turn end sent to the TV.
+func sentUntilTurnEnd(t *testing.T, msgBus *bus.MessageBus) []sent {
+	t.Helper()
+	var got []sent
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case out := <-msgBus.OutboundChan():
+			kind := out.Context.Raw[metadataKeyMessageKind]
+			if kind == "" && out.Context.Raw[metadataKeyOutboundKind] == outboundKindFinal {
+				kind = "final"
+			}
+			got = append(got, sent{out.Channel, out.ChatID, kind, out.Content})
+			if kind == "turn_end" {
+				return got
+			}
+		case <-deadline:
+			t.Fatalf("no turn end for the TV; sent: %v", got)
+		}
+	}
+}
+
+// A TV question is a message of the owner's Telegram DM: it lands in the DM's session, the DM sees it
+// as "📺 …" and gets the answer, and the TV learns the turn is over.
+func TestSharedDialog_TVMessageJoinsTheTelegramDM(t *testing.T) {
+	al, msgBus := startDialogLoop(t, &dialogProvider{answers: []string{"answer"}})
+	publishInbound(t, msgBus, tvMessage("tv question"))
+
+	want := []sent{
+		{"telegram", "11111111", "user", "📺 tv question"},
+		{"telegram", "11111111", "final", "answer"},
+		{"pico", "pico:tv", "turn_end", ""},
+	}
+	if got := sentUntilTurnEnd(t, msgBus); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sent = %v, want %v", got, want)
+	}
+	history := al.GetRegistry().GetDefaultAgent().Sessions.GetHistory(ownerDMKey)
+	if len(history) == 0 || history[0].Role != "user" || history[0].Content != "tv question" {
+		t.Fatalf("Telegram DM session history = %#v, want the TV question first", history)
+	}
+}
+
+// A TV linked to a Telegram group joins the group's dialog: its question lands in the session a message
+// typed in the group gets, the group sees it as "📺 …" and gets the answer.
+func TestSharedDialog_TVMessageJoinsALinkedTelegramGroup(t *testing.T) {
+	al, msgBus := startLinkedDialogLoop(t, &dialogProvider{answers: []string{"answer"}}, "telegram:-1009876543")
+	publishInbound(t, msgBus, tvMessage("tv question"))
+
+	want := []sent{
+		{"telegram", "-1009876543", "user", "📺 tv question"},
+		{"telegram", "-1009876543", "final", "answer"},
+		{"pico", "pico:tv", "turn_end", ""},
+	}
+	if got := sentUntilTurnEnd(t, msgBus); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sent = %v, want %v", got, want)
+	}
+	history := al.GetRegistry().GetDefaultAgent().Sessions.GetHistory(ownerGroupKey)
+	if len(history) == 0 || history[0].Role != "user" || history[0].Content != "tv question" {
+		t.Fatalf("Telegram group session history = %#v, want the TV question first", history)
+	}
+}
+
+// A Telegram message shows on the TV as the owner's line, and the TV learns when its turn is over.
+func TestSharedDialog_TelegramMessageShowsOnTheTV(t *testing.T) {
+	_, msgBus := startDialogLoop(t, &dialogProvider{answers: []string{"answer"}})
+	publishInbound(t, msgBus, dmMessage("telegram question"))
+
+	want := []sent{
+		{"pico", "pico:tv", "user", "telegram question"},
+		{"telegram", "11111111", "final", "answer"},
+		{"pico", "pico:tv", "turn_end", ""},
+	}
+	if got := sentUntilTurnEnd(t, msgBus); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sent = %v, want %v", got, want)
+	}
+}
+
+// A TV question in the middle of a Telegram turn is picked up by that turn, as a second Telegram
+// message would be: it is steered in, and the turn's one answer covers it.
+func TestSharedDialog_TVMessageDuringTelegramTurnIsPickedUp(t *testing.T) {
+	provider := &dialogProvider{
+		answers:      []string{"first answer", "answer with the tv question"},
+		firstStarted: make(chan struct{}),
+		hold:         make(chan struct{}),
+	}
+	al, msgBus := startDialogLoop(t, provider)
+	publishInbound(t, msgBus, dmMessage("telegram question"))
+	select {
+	case <-provider.firstStarted:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the Telegram turn did not reach the provider")
+	}
+
+	publishInbound(t, msgBus, tvMessage("tv question"))
+	for deadline := time.Now().Add(2 * time.Second); al.pendingSteeringCountForScope(ownerDMKey) != 1; {
+		if time.Now().After(deadline) {
+			t.Fatalf("the TV question is not queued into the running turn (%d queued)",
+				al.pendingSteeringCountForScope(ownerDMKey))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	close(provider.hold)
+
+	want := []sent{
+		{"pico", "pico:tv", "user", "telegram question"},
+		{"telegram", "11111111", "user", "📺 tv question"},
+		{"telegram", "11111111", "final", "answer with the tv question"},
+		{"pico", "pico:tv", "turn_end", ""},
+	}
+	if got := sentUntilTurnEnd(t, msgBus); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sent = %v, want %v", got, want)
+	}
+	provider.mu.Lock()
+	defer provider.mu.Unlock()
+	if len(provider.calls) != 2 {
+		t.Fatalf("provider calls = %d, want 2", len(provider.calls))
+	}
+	last := provider.calls[1][len(provider.calls[1])-1]
+	if last.Role != "user" || last.Content != "tv question" {
+		t.Fatalf("second call ends with %#v, want the TV question", last)
+	}
+}
diff --git a/pkg/channels/linked_mirror.go b/pkg/channels/linked_mirror.go
new file mode 100644
index 0000000..15b4909
--- /dev/null
+++ b/pkg/channels/linked_mirror.go
@@ -0,0 +1,57 @@
+package channels
+
+import (
+	"context"
+	"maps"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+// mirrorToLinkedChats copies a message for a chat that session.identity_links joins with others into
+// one dialog to those other chats, so a turn shows in all of them: the TV gets every text the linked
+// Telegram chat gets, from the outbound queue and from SendMessage (the message tool), but no files
+// (SendMedia). The owner's echoes ("user") and the turn end ("turn_end") are addressed by the agent to
+// the chats that need them and are not copied. Returns false when ctx is done.
+func (m *Manager) mirrorToLinkedChats(ctx context.Context, msg bus.OutboundMessage) bool {
+	kind := msg.Context.Raw["message_kind"]
+	if m.config == nil || kind == "user" || kind == "turn_end" {
+		return true
+	}
+	for _, c := range m.config.Session.LinkedChats(msg.Context.Channel, msg.ChatID) {
+		if c.Channel == msg.Context.Channel && c.ChatID == msg.ChatID {
+			continue
+		}
+		m.mu.RLock()
+		w := m.workers[c.Channel]
+		m.mu.RUnlock()
+		if w == nil {
+			continue
+		}
+		select {
+		case w.queue <- linkedCopy(msg, c):
+		case <-ctx.Done():
+			return false
+		}
+	}
+	return true
+}
+
+// linkedCopy readdresses msg to chat c. A pico client gets a Telegram step as kind "step" and the turn's
+// answer (or error) as kind "final", so it can tell them from interim text.
+func linkedCopy(msg bus.OutboundMessage, c config.LinkedChat) bus.OutboundMessage {
+	msg.Channel, msg.ChatID, msg.ReplyToMessageID = c.Channel, c.ChatID, ""
+	msg.Context = bus.InboundContext{Channel: c.Channel, ChatID: c.ChatID, Raw: maps.Clone(msg.Context.Raw)}
+	if c.Channel == "pico" {
+		if msg.Context.Raw == nil {
+			msg.Context.Raw = map[string]string{}
+		}
+		switch {
+		case outboundMessageIsToolFeedback(msg):
+			msg.Context.Raw["message_kind"] = "step"
+		case outboundMessageIsFinal(msg):
+			msg.Context.Raw["message_kind"] = "final"
+		}
+	}
+	return msg
+}
diff --git a/pkg/channels/linked_mirror_test.go b/pkg/channels/linked_mirror_test.go
new file mode 100644
index 0000000..b39f8b3
--- /dev/null
+++ b/pkg/channels/linked_mirror_test.go
@@ -0,0 +1,123 @@
+package channels
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+// The text a turn sends to the owner's Telegram DM (not its files) also goes to the TV, the step and the
+// answer marked for it; the agent's own "user" echo to the DM is not copied back.
+func TestLinkedMirror_TelegramDMMessagesReachTheTV(t *testing.T) {
+	mb := bus.NewMessageBus()
+	defer mb.Close()
+	m := &Manager{
+		channels: map[string]Channel{"telegram": &mockChannel{}, "pico": &mockChannel{}},
+		workers:  map[string]*channelWorker{},
+		bus:      mb,
+		config: &config.Config{Session: config.SessionConfig{
+			IdentityLinks: map[string][]string{"owner": {"telegram:11111111", "pico:tv"}},
+		}},
+	}
+	m.workers["telegram"] = newChannelWorker("telegram", m.channels["telegram"], "telegram")
+	m.workers["pico"] = newChannelWorker("pico", m.channels["pico"], "pico")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go m.dispatchOutbound(ctx)
+
+	dm := func(content string, raw map[string]string) bus.OutboundMessage {
+		return bus.OutboundMessage{
+			Context: bus.InboundContext{Channel: "telegram", ChatID: "11111111", Raw: raw},
+			Content: content,
+		}
+	}
+	for _, msg := range []bus.OutboundMessage{
+		dm("📺 tv question", map[string]string{"message_kind": "user"}),
+		dm("Смотрю версию ядра (`exec`)", map[string]string{"message_kind": "tool_feedback"}),
+		dm("Context window exceeded. Compressing history and retrying...", nil),
+		dm("4.9.113", map[string]string{"outbound_kind": "final"}),
+	} {
+		if err := mb.PublishOutbound(ctx, msg); err != nil {
+			t.Fatalf("publish: %v", err)
+		}
+	}
+
+	next := func(w *channelWorker) bus.OutboundMessage {
+		select {
+		case msg := <-w.queue:
+			return msg
+		case <-time.After(2 * time.Second):
+			t.Fatal("no message in the worker queue")
+			return bus.OutboundMessage{}
+		}
+	}
+	for i := 0; i < 4; i++ {
+		if got := next(m.workers["telegram"]); got.Context.Channel != "telegram" || got.ChatID != "11111111" {
+			t.Fatalf("Telegram message %d went to %s/%s", i, got.Context.Channel, got.ChatID)
+		}
+	}
+	for _, want := range []struct{ kind, content string }{
+		{"step", "Смотрю версию ядра (`exec`)"},
+		{"", "Context window exceeded. Compressing history and retrying..."},
+		{"final", "4.9.113"},
+	} {
+		got := next(m.workers["pico"])
+		if got.Context.Channel != "pico" || got.ChatID != "pico:tv" || got.Context.ChatID != "pico:tv" {
+			t.Fatalf("TV copy of %q went to %s/%s", want.content, got.Context.Channel, got.ChatID)
+		}
+		if got.Context.Raw["message_kind"] != want.kind || got.Content != want.content {
+			t.Fatalf("TV copy = %q kind %q, want %q kind %q",
+				got.Content, got.Context.Raw["message_kind"], want.content, want.kind)
+		}
+	}
+	select {
+	case extra := <-m.workers["pico"].queue:
+		t.Fatalf("unexpected TV copy %q", extra.Content)
+	case <-time.After(100 * time.Millisecond):
+	}
+}
+
+// The message tool sends to the DM through Manager.SendMessage, past the outbound queue; the TV gets
+// that text too, once and whole.
+func TestLinkedMirror_MessageToolTextReachesTheTV(t *testing.T) {
+	// Telegram splits at 10 characters, so the TV copy proves it is sent once and whole.
+	telegram := &mockChannel{BaseChannel: BaseChannel{maxMessageLength: 10}}
+	m := &Manager{
+		channels: map[string]Channel{"telegram": telegram, "pico": &mockChannel{}},
+		workers:  map[string]*channelWorker{},
+		bus:      bus.NewMessageBus(),
+		config: &config.Config{Session: config.SessionConfig{
+			IdentityLinks: map[string][]string{"owner": {"telegram:11111111", "pico:tv"}},
+		}},
+	}
+	defer m.bus.Close()
+	m.workers["telegram"] = newChannelWorker("telegram", telegram, "telegram")
+	m.workers["pico"] = newChannelWorker("pico", m.channels["pico"], "pico")
+
+	if err := m.SendMessage(context.Background(), bus.OutboundMessage{
+		Context: bus.NewOutboundContext("telegram", "11111111", ""),
+		Content: "answer sent with the message tool",
+	}); err != nil {
+		t.Fatalf("SendMessage: %v", err)
+	}
+	if len(telegram.sentMessages) < 2 {
+		t.Fatalf("Telegram got %d messages, want the text split into parts", len(telegram.sentMessages))
+	}
+	select {
+	case got := <-m.workers["pico"].queue:
+		if got.ChatID != "pico:tv" || got.Content != "answer sent with the message tool" ||
+			got.Context.Raw["message_kind"] != "" {
+			t.Fatalf("TV copy = %s %q kind %q", got.ChatID, got.Content, got.Context.Raw["message_kind"])
+		}
+	case <-time.After(time.Second):
+		t.Fatal("the TV got nothing")
+	}
+	select {
+	case extra := <-m.workers["pico"].queue:
+		t.Fatalf("unexpected second TV copy %q", extra.Content)
+	case <-time.After(100 * time.Millisecond):
+	}
+}
