+func TestSend_AnswerAsNewMessageSendsReplyAndDeletesProgressMessage(t *testing.T) {
+	caller := &stubCaller{
+		callFn: func(ctx context.Context, url string, data *ta.RequestData) (*ta.Response, error) {
+			switch {
+			case strings.Contains(url, "sendMessage"):
+				return successResponseWithMessageID(t, 2), nil
+			case strings.Contains(url, "deleteMessage"):
+				return &ta.Response{Ok: true, Result: json.RawMessage("true")}, nil
+			default:
+				t.Fatalf("unexpected API call: %s", url)
+				return nil, nil
+			}
+		},
+	}
+	ch := newTestChannel(t, caller)
+	ch.tgCfg.AnswerAsNewMessage = true
+	ch.RecordToolFeedbackMessage("12345", "1", "🔧 `read_file`")
+
+	ids, err := ch.Send(context.Background(), bus.OutboundMessage{
+		ChatID:  "12345",
+		Content: "final reply",
+	})
+
+	require.NoError(t, err)
+	assert.Equal(t, []string{"2"}, ids)
+	require.Len(t, caller.calls, 2)
+	assert.Contains(t, caller.calls[0].URL, "sendMessage")
+	assert.NotContains(t, string(caller.calls[0].Data.BodyRaw), `"disable_notification"`)
+	assert.Contains(t, caller.calls[1].URL, "deleteMessage")
+	assert.Contains(t, string(caller.calls[1].Data.BodyRaw), `"message_id":1`)
+	_, ok := ch.currentToolFeedbackMessage("12345")
+	assert.False(t, ok, "tracked tool feedback should be cleared after final reply")
+}
