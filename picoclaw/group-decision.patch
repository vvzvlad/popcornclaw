+const (
+	// DefaultGroupDecisionMinConfidence is the probability at or above which a
+	// group message is answered when min_confidence is not set.
+	DefaultGroupDecisionMinConfidence = 0.5
+	// DefaultGroupDecisionTimeoutMS bounds one decision request when timeout_ms is not set.
+	DefaultGroupDecisionTimeoutMS = 3000
+)
+
+// GroupDecisionConfig configures a decision model that judges whether a group
+// message is addressed to the bot. When Model and APIKey are set, it replaces
+// the mention_only/prefixes rules for messages that do not mention the bot.
+type GroupDecisionConfig struct {
+	Model           string       `json:"model,omitempty"            yaml:"-"`
+	APIKey          SecureString `json:"api_key,omitzero"           yaml:"api_key,omitempty"`
+	MinConfidence   float64      `json:"min_confidence,omitempty"   yaml:"-"`
+	TimeoutMS       int          `json:"timeout_ms,omitempty"       yaml:"-"`
+	Proxy           string       `json:"proxy,omitempty"            yaml:"-"` // HTTP proxy URL
+	BotDescription  string       `json:"bot_description,omitempty"  yaml:"-"` // what the bot does, for the model
+	ChatDescription string       `json:"chat_description,omitempty" yaml:"-"` // what the chat is, for the model
+}
+
+// Enabled reports whether the decision model is configured.
+func (d GroupDecisionConfig) Enabled() bool {
+	return d.Model != "" && d.APIKey.String() != ""
+}
+
+// Threshold returns the minimum probability for answering a message.
+func (d GroupDecisionConfig) Threshold() float64 {
+	if d.MinConfidence > 0 {
+		return d.MinConfidence
+	}
+	return DefaultGroupDecisionMinConfidence
+}
+
+// Timeout returns the time limit of one decision request.
+func (d GroupDecisionConfig) Timeout() time.Duration {
+	if d.TimeoutMS > 0 {
+		return time.Duration(d.TimeoutMS) * time.Millisecond
+	}
+	return DefaultGroupDecisionTimeoutMS * time.Millisecond
 }
 
