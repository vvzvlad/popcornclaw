+// TestShellTool_BareSlashesNotBlocked verifies that a token made only of
+// slashes, such as jq's alternative operator "//", is not taken for a path
+// outside the workspace, while a real path in the same command still is.
+func TestShellTool_BareSlashesNotBlocked(t *testing.T) {
+	tmpDir := t.TempDir()
+	tool, err := NewExecTool(tmpDir, true)
+	if err != nil {
+		t.Fatalf("unable to configure exec tool: %s", err)
+	}
+
+	allowedCommands := []string{
+		`jq -r '.records[] | .fields.Name // "none"' data.json`,
+		`jq -r '.records[] | (.fields.Type // "")' data.json`,
+		`jq -r 'split("//")' data.json`,
+	}
+	for _, cmd := range allowedCommands {
+		if got := tool.guardCommand(cmd, tmpDir); got != "" {
+			t.Errorf("command should not be blocked: %q\n  got: %s", cmd, got)
+		}
+	}
+
+	blockedCommands := []string{
+		`jq -r '.name // "none"' /etc/passwd`,
+		"cat //etc/passwd",
+	}
+	for _, cmd := range blockedCommands {
+		if got := tool.guardCommand(cmd, tmpDir); !strings.Contains(got, "path outside working dir") {
+			t.Errorf("command should be blocked: %q\n  got: %q", cmd, got)
+		}
+	}
+}
