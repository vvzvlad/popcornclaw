diff --git a/pkg/channels/telegram/telegram_group_decision_test.go b/pkg/channels/telegram/telegram_group_decision_test.go
new file mode 100644
index 00000000..83d5056a
--- /dev/null
+++ b/pkg/channels/telegram/telegram_group_decision_test.go
@@ -0,0 +1,397 @@
+package telegram
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/mymmrac/telego"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/channels"
+	"github.com/sipeed/picoclaw/pkg/commands"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+// Telegram group chat IDs are negative.
+const testGroupChatKey = "-123"
+
+type spyDecider struct {
+	p        float64
+	err      error
+	requests []channels.GroupReplyRequest
+}
+
+func (s *spyDecider) ReplyProbability(_ context.Context, req channels.GroupReplyRequest) (float64, error) {
+	s.requests = append(s.requests, req)
+	return s.p, s.err
+}
+
+func newGroupDecisionChannel(t *testing.T, decider channels.GroupReplyDecider) (*TelegramChannel, *bus.MessageBus) {
+	t.Helper()
+
+	messageBus := bus.NewMessageBus()
+	ch := &TelegramChannel{
+		BaseChannel: channels.NewBaseChannel("telegram", nil, messageBus, []string{"7", "8"},
+			channels.WithGroupTrigger(config.GroupTriggerConfig{MentionOnly: true}),
+		),
+		bot:     newTestTelegramBot(t, "testbot"),
+		chatIDs: make(map[string]int64),
+		ctx:     context.Background(),
+	}
+	ch.SetGroupDecider(decider)
+	ch.setOwnCommands([]commands.Definition{{Name: "new"}})
+	return ch, messageBus
+}
+
+func groupMessage(id int, from int64, text string, entities ...telego.MessageEntity) *telego.Message {
+	return &telego.Message{
+		Text:      text,
+		Entities:  entities,
+		MessageID: id,
+		Date:      time.Now().Unix(),
+		Chat:      telego.Chat{ID: -123, Type: "group"},
+		From:      &telego.User{ID: from, FirstName: "User", Username: map[int64]string{7: "alice", 8: "bob"}[from]},
+	}
+}
+
+func commandEntity(text string) telego.MessageEntity {
+	return telego.MessageEntity{Type: telego.EntityTypeBotCommand, Offset: 0, Length: len([]rune(text))}
+}
+
+func forwardedContent(t *testing.T, messageBus *bus.MessageBus) (string, bool) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	select {
+	case inbound := <-messageBus.InboundChan():
+		return inbound.Content, true
+	case <-ctx.Done():
+		return "", false
+	}
+}
+
+func TestGroupDecision_MentionBypassesDecider(t *testing.T) {
+	spy := &spyDecider{err: errors.New("must not be called")}
+	ch, messageBus := newGroupDecisionChannel(t, spy)
+
+	msg := groupMessage(1, 7, "@testbot hello", telego.MessageEntity{
+		Type: telego.EntityTypeMention, Offset: 0, Length: len("@testbot"),
+	})
+	if err := ch.handleMessage(context.Background(), msg); err != nil {
+		t.Fatal(err)
+	}
+
+	if content, ok := forwardedContent(t, messageBus); !ok || content != "hello" {
+		t.Fatalf("forwarded = %q, %v; want \"hello\", true", content, ok)
+	}
+	if len(spy.requests) != 0 {
+		t.Fatalf("decider called %d times for a mention", len(spy.requests))
+	}
+	if got := ch.GroupHistory().Recent(testGroupChatKey, 1000, time.Now()); len(got) != 1 || got[0].From != "alice" {
+		t.Fatalf("history = %+v, want the mention recorded", got)
+	}
+}
+
+func TestGroupDecision_Commands(t *testing.T) {
+	tests := []struct {
+		name          string
+		text          string
+		wantForwarded bool
+	}{
+		{"known bare command", "/new", true},
+		{"command with this bot", "/print@testbot", true},
+		{"unknown bare command", "/print", false},
+		{"command for another bot", "/new@otherbot", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			spy := &spyDecider{p: 1}
+			ch, messageBus := newGroupDecisionChannel(t, spy)
+
+			if err := ch.handleMessage(context.Background(), groupMessage(1, 7, tc.text, commandEntity(tc.text))); err != nil {
+				t.Fatal(err)
+			}
+
+			if _, ok := forwardedContent(t, messageBus); ok != tc.wantForwarded {
+				t.Fatalf("forwarded = %v, want %v", ok, tc.wantForwarded)
+			}
+			if len(spy.requests) != 0 {
+				t.Fatalf("decider called %d times for a command", len(spy.requests))
+			}
+		})
+	}
+}
+
+func TestGroupDecision_DeciderVerdict(t *testing.T) {
+	tests := []struct {
+		name          string
+		decider       *spyDecider
+		wantForwarded bool
+	}{
+		{"yes", &spyDecider{p: 0.9}, true},
+		{"at the threshold", &spyDecider{p: 0.5}, true},
+		{"no", &spyDecider{p: 0.1}, false},
+		{"error", &spyDecider{p: 1, err: errors.New("decision model unavailable")}, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ch, messageBus := newGroupDecisionChannel(t, tc.decider)
+
+			if err := ch.handleMessage(context.Background(), groupMessage(1, 7, "  how many glazes?  ")); err != nil {
+				t.Fatal(err)
+			}
+
+			content, ok := forwardedContent(t, messageBus)
+			if ok != tc.wantForwarded {
+				t.Fatalf("forwarded = %v, want %v", ok, tc.wantForwarded)
+			}
+			if ok && content != "how many glazes?" {
+				t.Fatalf("content = %q", content)
+			}
+			if len(tc.decider.requests) != 1 {
+				t.Fatalf("decider called %d times, want 1", len(tc.decider.requests))
+			}
+		})
+	}
+}
+
+func TestGroupDecision_RequestCarriesHistoryAndReply(t *testing.T) {
+	spy := &spyDecider{p: 0}
+	ch, _ := newGroupDecisionChannel(t, spy)
+	botUser := &telego.User{ID: ch.bot.ID(), IsBot: true, Username: "testbot"}
+
+	ch.RecordSentMessage(testGroupChatKey, nil, "Recorded the expense", []string{"1"})
+	if err := ch.handleMessage(context.Background(), groupMessage(2, 7, "thanks")); err != nil {
+		t.Fatal(err)
+	}
+	reply := groupMessage(3, 8, "and the second one?")
+	reply.ReplyToMessage = &telego.Message{MessageID: 1, From: botUser, Text: "Recorded the expense"}
+	if err := ch.handleMessage(context.Background(), reply); err != nil {
+		t.Fatal(err)
+	}
+
+	if len(spy.requests) != 2 {
+		t.Fatalf("decider called %d times, want 2", len(spy.requests))
+	}
+	first, second := spy.requests[0], spy.requests[1]
+	if first.BotUsername != "testbot" || first.Message.From != "alice" || first.Message.Text != "thanks" {
+		t.Errorf("first request = %+v", first)
+	}
+	if first.RepliedTo != nil || first.RepliesToBot {
+		t.Errorf("first request is not a reply: %+v", first)
+	}
+	if len(first.History) != 1 || first.History[0].From != "bot" {
+		t.Errorf("first history = %+v, want the bot's own message", first.History)
+	}
+	if first.BotLast == nil || first.BotLast.Text != "Recorded the expense" {
+		t.Errorf("first BotLast = %+v", first.BotLast)
+	}
+
+	if !second.RepliesToBot || second.RepliedTo == nil || second.RepliedTo.From != "bot" ||
+		second.RepliedTo.Text != "Recorded the expense" {
+		t.Errorf("second request does not carry the reply to the bot: %+v", second)
+	}
+	if len(second.History) != 2 || second.History[1].From != "alice" || second.History[1].Text != "thanks" {
+		t.Errorf("second history = %+v, want the bot message then alice's", second.History)
+	}
+	hist := ch.GroupHistory().Recent(testGroupChatKey, 1000, time.Now())
+	if len(hist) != 3 || hist[2].ReplyTo != "bot" {
+		t.Errorf("history = %+v, want 3 messages, the last replying to bot", hist)
+	}
+}
+
+func TestGroupDecision_RejectedSenderIsNotRecorded(t *testing.T) {
+	spy := &spyDecider{p: 1}
+	ch, messageBus := newGroupDecisionChannel(t, spy)
+
+	if err := ch.handleMessage(context.Background(), groupMessage(1, 99, "hello")); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, ok := forwardedContent(t, messageBus); ok {
+		t.Fatal("message of a sender outside allow_from was forwarded")
+	}
+	if len(spy.requests) != 0 || len(ch.GroupHistory().Recent(testGroupChatKey, 1000, time.Now())) != 0 {
+		t.Fatal("message of a sender outside allow_from reached the decider or the history")
+	}
+}
+
+func TestRecordSentMessage(t *testing.T) {
+	tests := []struct {
+		name       string
+		chatID     string
+		messageIDs []string
+		wantKey    string // history key the message must land in, empty when it must not be recorded
+	}{
+		{"group", testGroupChatKey, []string{"5"}, testGroupChatKey},
+		{"forum topic", testGroupChatKey + "/77", []string{"5"}, testGroupChatKey + "/77"},
+		{"last of several chunks", testGroupChatKey, []string{"5", "6"}, testGroupChatKey},
+		{"private chat", "55", []string{"5"}, ""},
+		{"no message id", testGroupChatKey, nil, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ch, _ := newGroupDecisionChannel(t, &spyDecider{})
+
+			ch.RecordSentMessage(tc.chatID, nil, "hi", tc.messageIDs)
+
+			recorded := 0
+			for _, key := range []string{testGroupChatKey, testGroupChatKey + "/77", "55"} {
+				got := ch.GroupHistory().Recent(key, 1000, time.Now())
+				recorded += len(got)
+				if key == tc.wantKey {
+					if len(got) != 1 || got[0].From != "bot" || got[0].Text != "hi" ||
+						got[0].MessageID != 5+len(tc.messageIDs)-1 {
+						t.Fatalf("history of %s = %+v", key, got)
+					}
+				}
+			}
+			if wantRecorded := map[bool]int{true: 1, false: 0}[tc.wantKey != ""]; recorded != wantRecorded {
+				t.Fatalf("%d messages recorded, want %d", recorded, wantRecorded)
+			}
+		})
+	}
+}
