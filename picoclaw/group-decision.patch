diff --git a/pkg/channels/group_decision.go b/pkg/channels/group_decision.go
new file mode 100644
index 00000000..f2d9506e
--- /dev/null
+++ b/pkg/channels/group_decision.go
@@ -0,0 +1,182 @@
+package channels
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/logger"
+)
+
+const (
+	// GroupHistoryMaxMessages is how many recent messages the decider gets.
+	GroupHistoryMaxMessages = 8
+	// GroupHistoryWindow is how old a history message may be to still count as recent.
+	GroupHistoryWindow = time.Hour
+	// GroupHistoryBotName is the sender recorded for the bot's own messages.
+	GroupHistoryBotName = "bot"
+
+	// groupHistoryStored is how many messages per chat are kept. It is larger
+	// than GroupHistoryMaxMessages because messages of one chat can be handled
+	// out of order: when an earlier message is judged, later ones may already be stored.
+	groupHistoryStored = 4 * GroupHistoryMaxMessages
+)
+
+// GroupMessage is a message as the reply decider sees it.
+type GroupMessage struct {
+	From string
+	Text string
+}
+
+// GroupHistoryEntry is one message of a group chat's recent history.
+type GroupHistoryEntry struct {
+	MessageID int // platform message ID, increasing within a chat; orders the history
+	From      string
+	Text      string
+	Time      time.Time
+	ReplyTo   string // sender of the message this one replies to; empty when it is not a reply
+}
+
+// GroupReplyRequest is everything a GroupReplyDecider gets to judge one group message.
+type GroupReplyRequest struct {
+	BotUsername  string
+	RepliesToBot bool
+	Now          time.Time // when Message was sent; the history ages are measured from it
+	Message      GroupMessage
+	RepliedTo    *GroupMessage       // nil when Message is not a reply
+	History      []GroupHistoryEntry // recent messages before Message, oldest first
+	BotLast      *GroupHistoryEntry  // the bot's last message before Message, nil when there is none
+}
+
+// GroupReplyDecider judges whether a group message that does not mention the
+// bot is addressed to it. Implementations return the probability in [0, 1] that
+// the bot should reply; an error means the message could not be judged.
+type GroupReplyDecider interface {
+	ReplyProbability(ctx context.Context, req GroupReplyRequest) (float64, error)
+}
+
+// GroupHistory keeps the recent messages of each group chat, ordered by message
+// ID, and the bot's own last messages. It is safe for concurrent use.
+type GroupHistory struct {
+	mu    sync.Mutex
+	chats map[string]*groupChatHistory
+}
+
+type groupChatHistory struct {
+	entries []GroupHistoryEntry // sorted by MessageID
+	bot     []GroupHistoryEntry // the bot's messages, sorted by MessageID
+}
+
+// NewGroupHistory returns an empty history.
+func NewGroupHistory() *GroupHistory {
+	return &GroupHistory{chats: make(map[string]*groupChatHistory)}
+}
+
+// Add stores a message in the chat's history at the place its MessageID gives,
+// whatever the order the messages arrive in. The oldest messages beyond the
+// storage cap are dropped.
+func (h *GroupHistory) Add(chatID string, e GroupHistoryEntry) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+
+	chat := h.chats[chatID]
+	if chat == nil {
+		chat = &groupChatHistory{}
+		h.chats[chatID] = chat
+	}
+	chat.entries = insertByMessageID(chat.entries, e, groupHistoryStored)
+	if e.From == GroupHistoryBotName {
+		chat.bot = insertByMessageID(chat.bot, e, GroupHistoryMaxMessages)
+	}
+}
+
+// Recent returns up to GroupHistoryMaxMessages of the chat's latest messages that
+// were sent before the message with ID beforeID and no longer ago than
+// GroupHistoryWindow at now, oldest first.
+func (h *GroupHistory) Recent(chatID string, beforeID int, now time.Time) []GroupHistoryEntry {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+
+	chat := h.chats[chatID]
+	if chat == nil {
+		return nil
+	}
+	var recent []GroupHistoryEntry
+	for _, e := range chat.entries {
+		if e.MessageID < beforeID && now.Sub(e.Time) <= GroupHistoryWindow {
+			recent = append(recent, e)
+		}
+	}
+	if extra := len(recent) - GroupHistoryMaxMessages; extra > 0 {
+		recent = recent[extra:]
+	}
+	return recent
+}
+
+// LastBot returns the bot's last message in the chat sent before the message
+// with ID beforeID, however old.
+func (h *GroupHistory) LastBot(chatID string, beforeID int) (GroupHistoryEntry, bool) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+
+	chat := h.chats[chatID]
+	if chat == nil {
+		return GroupHistoryEntry{}, false
+	}
+	for i := len(chat.bot) - 1; i >= 0; i-- {
+		if chat.bot[i].MessageID < beforeID {
+			return chat.bot[i], true
+		}
+	}
+	return GroupHistoryEntry{}, false
+}
+
+// insertByMessageID inserts e into entries (sorted by MessageID), replacing an
+// entry with the same ID, and keeps only the limit entries with the highest IDs.
+func insertByMessageID(entries []GroupHistoryEntry, e GroupHistoryEntry, limit int) []GroupHistoryEntry {
+	i := sort.Search(len(entries), func(i int) bool { return entries[i].MessageID >= e.MessageID })
+	if i < len(entries) && entries[i].MessageID == e.MessageID {
+		entries[i] = e
+		return entries
+	}
+	entries = append(entries, GroupHistoryEntry{})
+	copy(entries[i+1:], entries[i:])
+	entries[i] = e
+	if extra := len(entries) - limit; extra > 0 {
+		entries = append([]GroupHistoryEntry(nil), entries[extra:]...)
+	}
+	return entries
+}
+
+// SetGroupDecider injects the decider that judges group messages (nil disables it).
+func (c *BaseChannel) SetGroupDecider(d GroupReplyDecider) { c.groupDecider = d }
+
+// GroupDecider returns the injected GroupReplyDecider (may be nil).
+func (c *BaseChannel) GroupDecider() GroupReplyDecider { return c.groupDecider }
+
+// GroupHistory returns the per-chat history of group messages.
+func (c *BaseChannel) GroupHistory() *GroupHistory { return c.groupHistory }
+
+// ShouldRespondByDecision asks the injected decider whether to reply and logs
+// the outcome. The bot replies when the probability reaches the configured
+// min_confidence; when the decider fails the message is ignored.
+func (c *BaseChannel) ShouldRespondByDecision(ctx context.Context, chatID string, req GroupReplyRequest) bool {
+	p, err := c.groupDecider.ReplyProbability(ctx, req)
+	if err != nil {
+		logger.WarnCF("channels", "Group reply decision failed; ignoring message", map[string]any{
+			"channel": c.name,
+			"chat_id": chatID,
+			"error":   err.Error(),
+		})
+		return false
+	}
+	respond := p >= c.groupTrigger.Decision.Threshold()
+	logger.InfoCF("channels", "Group reply decision", map[string]any{
+		"channel":     c.name,
+		"chat_id":     chatID,
+		"probability": p,
+		"respond":     respond,
+	})
+	return respond
+}
diff --git a/pkg/channels/group_decision_test.go b/pkg/channels/group_decision_test.go
