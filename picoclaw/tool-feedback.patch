@@ -0,0 +1,43 @@
+package telegram
+
+import (
+	"context"
+	"testing"
+
+	ta "github.com/mymmrac/telego/telegoapi"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+)
+
+// Tool feedback steps arrive without a notification sound; the final reply still rings.
+func TestSend_ToolFeedbackIsSilentFinalReplyIsNot(t *testing.T) {
+	caller := &stubCaller{
+		callFn: func(ctx context.Context, url string, data *ta.RequestData) (*ta.Response, error) {
+			return successResponse(t), nil
+		},
+	}
+	ch := newTestChannel(t, caller)
+
+	_, err := ch.Send(context.Background(), bus.OutboundMessage{
+		ChatID:  "12345",
+		Content: "Смотрю файлы раздачи второго сезона (`mcp_tv_files`)",
+		Context: bus.InboundContext{
+			Channel: "telegram",
+			ChatID:  "12345",
+			Raw:     map[string]string{"message_kind": "tool_feedback"},
+		},
+	})
+	require.NoError(t, err)
+	// With separate tool feedback messages the manager drops the tracked step before the reply.
+	ch.ClearToolFeedbackMessage("12345")
+	_, err = ch.Send(context.Background(), bus.OutboundMessage{ChatID: "12345", Content: "final reply"})
+	require.NoError(t, err)
+
+	require.Len(t, caller.calls, 2)
+	assert.Contains(t, caller.calls[0].URL, "sendMessage")
+	assert.Contains(t, string(caller.calls[0].Data.BodyRaw), `"disable_notification":true`)
+	assert.Contains(t, caller.calls[1].URL, "sendMessage")
+	assert.NotContains(t, string(caller.calls[1].Data.BodyRaw), `"disable_notification"`)
+}
