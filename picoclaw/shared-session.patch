+++ b/pkg/channels/pico/shared_dialog_test.go
@@ -0,0 +1,40 @@
+package pico
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+)
+
+// The kinds of a dialog shared with Telegram reach the TV in the frame, so it can tell a step, the
+// answer, the owner's line and the turn end from interim text.
+func TestSend_SharedDialogKindsReachTheClient(t *testing.T) {
+	ch := newTestPicoChannel(t)
+	if err := ch.Start(context.Background()); err != nil {
+		t.Fatalf("Start() error = %v", err)
+	}
+	defer ch.Stop(context.Background())
+	clientConn, received, cleanup := newTestPicoWebSocket(t)
+	defer cleanup()
+	ch.addConnForTest(&picoConn{id: "conn-1", conn: clientConn, sessionID: "tv"})
+
+	for _, kind := range []string{"user", "step", "final", "turn_end"} {
+		if _, err := ch.Send(context.Background(), bus.OutboundMessage{
+			ChatID:  "pico:tv",
+			Content: "text",
+			Context: bus.InboundContext{Channel: "pico", ChatID: "pico:tv", Raw: map[string]string{"message_kind": kind}},
+		}); err != nil {
+			t.Fatalf("Send(%s) error = %v", kind, err)
+		}
+		select {
+		case msg := <-received:
+			if msg.Type != TypeMessageCreate || msg.Payload[PayloadKeyKind] != kind {
+				t.Fatalf("frame for %s = %s %#v, want message.create with kind %q", kind, msg.Type, msg.Payload, kind)
+			}
+		case <-time.After(time.Second):
+			t.Fatalf("no frame for %s", kind)
+		}
+	}
+}
diff --git a/pkg/config/linked_chats.go b/pkg/config/linked_chats.go
new file mode 100644
index 0000000..f25b343
--- /dev/null
+++ b/pkg/config/linked_chats.go
@@ -0,0 +1,36 @@
+package config
+
+import "strings"
+
+// LinkedChat is one chat of a dialog that several channels share.
+type LinkedChat struct {
+	Channel string
+	ChatID  string
+}
+
+// LinkedChats returns the chats that session.identity_links joins into one dialog with channel/chatID,
+// that chat included, or nil when it is not linked. An entry "<channel>:<id>" names the chat <id>; a pico
+// entry names the client's WebSocket session ("pico:tv" is the chat "pico:tv"), since every pico client
+// has the same sender.
+func (s SessionConfig) LinkedChats(channel, chatID string) []LinkedChat {
+	for _, ids := range s.IdentityLinks {
+		chats := make([]LinkedChat, 0, len(ids))
+		linked := false
+		for _, id := range ids {
+			ch, chat, ok := strings.Cut(strings.TrimSpace(id), ":")
+			if !ok {
+				continue
+			}
+			ch = strings.ToLower(ch)
+			if ch == "pico" {
+				chat = "pico:" + chat
+			}
+			chats = append(chats, LinkedChat{Channel: ch, ChatID: chat})
+			linked = linked || (ch == channel && chat == chatID)
+		}
+		if linked {
+			return chats
+		}
+	}
+	return nil
+}
