@@ -0,0 +1,240 @@
+// Package groupdecision implements channels.GroupReplyDecider on the OpenRouter
+// Decisions API: a decision model that answers one yes/no question about a group
+// message ("is it addressed to the bot?") with a probability and generates no text.
+package groupdecision
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/channels"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/utils"
+)
+
+const (
+	endpoint     = "https://openrouter.ai/api/alpha/decisions"
+	questionName = "addressed"
+
+	maxHistoryTextRunes   = 300
+	maxRepliedToTextRunes = 500
+	maxBotLastTextRunes   = 400
+	maxMessageTextRunes   = 1500
+	maxErrorBodyBytes     = 300
+)
+
+// Client asks a decision model whether a group message is addressed to the bot.
+type Client struct {
+	model           string
+	apiKey          string
+	botDescription  string
+	chatDescription string
+	endpoint        string
+	httpClient      *http.Client
+}
+
+var _ channels.GroupReplyDecider = (*Client)(nil)
+
+// New builds a Client from the group_trigger.decision config. Requests go
+// through cfg.Proxy when it is set (OpenRouter refuses some regions) and are
+// bounded by cfg.Timeout().
+func New(cfg config.GroupDecisionConfig) (*Client, error) {
+	httpClient, err := utils.CreateHTTPClient(cfg.Proxy, cfg.Timeout())
+	if err != nil {
+		return nil, fmt.Errorf("group decision http client: %w", err)
+	}
+	return &Client{
+		model:           cfg.Model,
+		apiKey:          cfg.APIKey.String(),
+		botDescription:  cfg.BotDescription,
+		chatDescription: cfg.ChatDescription,
+		endpoint:        endpoint,
+		httpClient:      httpClient,
+	}, nil
+}
+
+// ReplyProbability returns the model's probability that req.Message is addressed to the bot.
+func (c *Client) ReplyProbability(ctx context.Context, req channels.GroupReplyRequest) (float64, error) {
+	body, err := c.requestBody(req)
+	if err != nil {
+		return 0, err
+	}
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, c.endpoint, bytes.NewReader(body))
+	if err != nil {
+		return 0, fmt.Errorf("group decision request: %w", err)
+	}
+	httpReq.Header.Set("Authorization", "Bearer "+c.apiKey)
+	httpReq.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.httpClient.Do(httpReq)
+	if err != nil {
+		return 0, fmt.Errorf("group decision request: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		msg, _ := io.ReadAll(io.LimitReader(resp.Body, maxErrorBodyBytes))
+		return 0, fmt.Errorf("group decision: HTTP %d: %s", resp.StatusCode, strings.TrimSpace(string(msg)))
+	}
+
+	var out struct {
+		Answers map[string]struct {
+			Type string   `json:"type"`
+			Noul *float64 `json:"noul"`
+		} `json:"answers"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&out); err != nil {
+		return 0, fmt.Errorf("group decision response: %w", err)
+	}
+	answer, ok := out.Answers[questionName]
+	if !ok || answer.Type != "noul" || answer.Noul == nil {
+		return 0, fmt.Errorf("group decision response has no %q noul answer", questionName)
+	}
+	return *answer.Noul, nil
+}
+
+type decisionRequest struct {
+	Model     string              `json:"model"`
+	State     state               `json:"state"`
+	Questions map[string]question `json:"questions"`
+}
+
+type state struct {
+	Bot            bot             `json:"bot"`
+	Chat           string          `json:"chat"`
+	RecentMessages []recentMessage `json:"recent_messages"`
+	BotLastMessage any             `json:"bot_last_message"` // "none" or botLastMessage
+	Message        message         `json:"message"`
+}
+
+type bot struct {
+	Username string `json:"username"`
+	Does     string `json:"does"`
+}
+
+type recentMessage struct {
+	From    string  `json:"from"`
+	Text    string  `json:"text"`
+	When    string  `json:"when"`
+	ReplyTo *string `json:"reply_to"`
+}
+
+type botLastMessage struct {
+	Text string `json:"text"`
+	When string `json:"when"`
+}
+
+type message struct {
+	From            string     `json:"from"`
+	Text            string     `json:"text"`
+	RepliesTo       *repliesTo `json:"replies_to"`
+	RepliesToTheBot bool       `json:"replies_to_the_bot"`
+}
+
+type repliesTo struct {
+	From string  `json:"from"`
+	Text *string `json:"text"`
+}
+
+type question struct {
+	Type         string            `json:"type"`
+	Instructions string            `json:"instructions"`
+	Criteria     map[string]string `json:"criteria"`
+}
+
+func (c *Client) requestBody(req channels.GroupReplyRequest) ([]byte, error) {
+	username := "@" + strings.TrimPrefix(req.BotUsername, "@")
+
+	st := state{
+		Bot:            bot{Username: username, Does: c.botDescription},
+		Chat:           c.chatDescription,
+		RecentMessages: make([]recentMessage, 0, len(req.History)),
+		BotLastMessage: "none",
+		Message: message{
+			From:            req.Message.From,
+			Text:            capText(req.Message.Text, maxMessageTextRunes),
+			RepliesToTheBot: req.RepliesToBot,
+		},
+	}
+	for _, h := range req.History {
+		m := recentMessage{
+			From: h.From,
+			Text: capText(h.Text, maxHistoryTextRunes),
+			When: ageWords(req.Now.Sub(h.Time)),
+		}
+		if h.ReplyTo != "" {
+			replyTo := h.ReplyTo
+			m.ReplyTo = &replyTo
+		}
+		st.RecentMessages = append(st.RecentMessages, m)
+	}
+	if req.BotLast != nil {
+		st.BotLastMessage = botLastMessage{
+			Text: capText(req.BotLast.Text, maxBotLastTextRunes),
+			When: ageWords(req.Now.Sub(req.BotLast.Time)),
+		}
+	}
+	if req.RepliedTo != nil {
+		replied := &repliesTo{From: req.RepliedTo.From}
+		if text := capText(req.RepliedTo.Text, maxRepliedToTextRunes); text != "" {
+			replied.Text = &text
+		}
+		st.Message.RepliesTo = replied
+	}
+
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	err := enc.Encode(decisionRequest{
+		Model:     c.model,
+		State:     st,
+		Questions: map[string]question{questionName: addressedQuestion(username)},
+	})
+	if err != nil {
+		return nil, fmt.Errorf("group decision request: %w", err)
+	}
+	return buf.Bytes(), nil
+}
+
+func addressedQuestion(botUsername string) question {
+	return question{
+		Type: "noul",
+		Instructions: "In this Telegram group chat, is `message` addressed to the bot " + botUsername +
+			" (a request, question or task for it, data for it to record, an answer to its question, " +
+			"or a confirmation or correction of what it just did), rather than people talking to each " +
+			"other, a remark about the bot, or a command for another bot?",
+		Criteria: map[string]string{"true": "", "false": ""},
+	}
+}
+
+// capText trims s and cuts it to max runes, marking the cut with an ellipsis.
+func capText(s string, limit int) string {
+	s = strings.TrimSpace(s)
+	runes := []rune(s)
+	if len(runes) <= limit {
+		return s
+	}
+	return string(runes[:limit]) + "…"
+}
+
+// ageWords describes how long ago a message was sent.
+func ageWords(age time.Duration) string {
+	switch {
+	case age < 2*time.Minute:
+		return "just now"
+	case age < 15*time.Minute:
+		return "a few minutes earlier"
+	case age < time.Hour:
+		return "within the last hour"
+	case age < 24*time.Hour:
+		return "hours earlier"
+	default:
+		return "days earlier"
+	}
+}
