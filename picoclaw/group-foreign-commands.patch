+// The own-command set has to be complete when Start returns, even while the
+// background command registration is still failing and retrying.
+func TestStart_FillsOwnCommandsBeforeRegistration(t *testing.T) {
+	ch, _ := newGroupMentionOnlyChannel(t, "testbot")
+	ch.tgCfg = &config.TelegramSettings{}
+	ch.registerFunc = func(context.Context, []commands.Definition) error {
+		return errors.New("registration keeps failing")
+	}
+	ch.commandRegDelayFn = func(int) time.Duration { return time.Hour }
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	if err := ch.Start(ctx); err != nil {
+		t.Fatalf("Start error: %v", err)
+	}
+
+	for _, def := range commands.BuiltinDefinitions() {
+		if !ch.isOwnCommand(def.Name) {
+			t.Errorf("builtin command %q is not known as own command after Start", def.Name)
+		}
+	}
+	if ch.isOwnCommand("print") {
+		t.Error("unknown command is known as own command")
+	}
