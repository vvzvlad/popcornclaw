+func TestSend_PostsReply(t *testing.T) {
+	type request struct {
+		contentType string
+		body        map[string]string
+	}
+	received := make(chan request, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		var body map[string]string
+		_ = json.Unmarshal(raw, &body)
+		received <- request{contentType: r.Header.Get("Content-Type"), body: body}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	ch, _ := newTestChannel(t, &config.WebhookSettings{
+		Secret:  *config.NewSecureString(testSecret),
+		SendURL: server.URL,
+	})
+
+	_, err := ch.Send(context.Background(), bus.OutboundMessage{ChatID: "t1", Content: "done"})
+	require.NoError(t, err)
+
+	req := <-received
+	assert.Equal(t, "application/json", req.contentType)
+	assert.Equal(t, map[string]string{"content": "done", "thread_id": "t1", "recipient": "t1"}, req.body)
+}
