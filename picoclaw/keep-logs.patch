diff --git a/pkg/memory/jsonl_archive_test.go b/pkg/memory/jsonl_archive_test.go
new file mode 100644
index 0000000..a043714
--- /dev/null
+++ b/pkg/memory/jsonl_archive_test.go
@@ -0,0 +1,68 @@
+package memory
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sipeed/picoclaw/pkg/providers"
+)
+
+// readArchive decodes every line of <sessions>/archive/<key>.jsonl.
+func readArchive(t *testing.T, store *JSONLStore, key string) []providers.Message {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(store.dir, "archive", sanitizeKey(key)+".jsonl"))
+	if err != nil {
+		t.Fatalf("read archive: %v", err)
+	}
+	var msgs []providers.Message
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		var m providers.Message
+		if err := json.Unmarshal([]byte(line), &m); err != nil {
+			t.Fatalf("decode archive line %q: %v", line, err)
+		}
+		msgs = append(msgs, m)
+	}
+	return msgs
+}
+
+func TestArchiveKeepsMessagesThatCompactAndSetHistoryDrop(t *testing.T) {
+	store := newTestStore(t)
+	ctx := context.Background()
+	key := "agent:main:telegram:direct:1"
+
+	for _, text := range []string{"one", "two", "three"} {
+		if err := store.AddMessage(ctx, key, "user", text); err != nil {
+			t.Fatalf("AddMessage: %v", err)
+		}
+	}
+	if err := store.TruncateHistory(ctx, key, 1); err != nil {
+		t.Fatalf("TruncateHistory: %v", err)
+	}
+	if err := store.Compact(ctx, key); err != nil {
+		t.Fatalf("Compact: %v", err)
+	}
+	if err := store.SetHistory(ctx, key, []providers.Message{{Role: "user", Content: "replaced"}}); err != nil {
+		t.Fatalf("SetHistory: %v", err)
+	}
+
+	history, err := store.GetHistory(ctx, key)
+	if err != nil {
+		t.Fatalf("GetHistory: %v", err)
+	}
+	if len(history) != 1 || history[0].Content != "replaced" {
+		t.Fatalf("live history = %+v, want only the replaced message", history)
+	}
+
+	archived := readArchive(t, store, key)
+	var got []string
+	for _, m := range archived {
+		got = append(got, m.Content)
+	}
+	if strings.Join(got, ",") != "one,two,three" {
+		t.Fatalf("archive = %v, want every appended message in order", got)
+	}
+}
