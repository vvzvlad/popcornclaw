+// Images the standard library can decode are re-encoded as JPEG and downscaled to at most this
+// long side before they go to the model: the provider rejects requests of a few MB (413), a
+// full-size screen capture is a 2 MB PNG, and every image loaded in a turn is resent with each
+// request of that turn.
+const (
+	llmImageMaxSide     = 1280
+	llmImageJPEGQuality = 80
+)
+
+// shrinkImageForLLM decodes a PNG, JPEG or GIF file and returns it as a JPEG no larger than
+// llmImageMaxSide on its long side. ok is false when the file cannot be decoded; the caller
+// then sends the file unchanged.
+func shrinkImageForLLM(path string) (data []byte, ok bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, false
+	}
+	defer f.Close()
+	src, _, err := image.Decode(f)
+	if err != nil {
+		return nil, false
+	}
+	b := src.Bounds()
+	w, h := b.Dx(), b.Dy()
+	if w <= 0 || h <= 0 {
+		return nil, false
+	}
+	dw, dh := w, h
+	if long := max(w, h); long > llmImageMaxSide {
+		dw = max(1, w*llmImageMaxSide/long)
+		dh = max(1, h*llmImageMaxSide/long)
+	}
+	full := image.NewRGBA(image.Rect(0, 0, w, h))
+	// JPEG has no alpha: flatten onto white so transparent areas do not turn black.
+	draw.Draw(full, full.Bounds(), image.White, image.Point{}, draw.Src)
+	draw.Draw(full, full.Bounds(), src, b.Min, draw.Over)
+	dst := image.NewRGBA(image.Rect(0, 0, dw, dh))
+	// Area average: each destination pixel is the mean of the source pixels it covers.
+	for y := 0; y < dh; y++ {
+		y0, y1 := y*h/dh, max((y+1)*h/dh, y*h/dh+1)
+		for x := 0; x < dw; x++ {
+			x0, x1 := x*w/dw, max((x+1)*w/dw, x*w/dw+1)
+			var sum [4]uint32
+			for sy := y0; sy < y1; sy++ {
+				row := full.Pix[sy*full.Stride:]
+				for sx := x0; sx < x1; sx++ {
+					for c := 0; c < 4; c++ {
+						sum[c] += uint32(row[sx*4+c])
+					}
+				}
+			}
+			n := uint32((y1 - y0) * (x1 - x0))
+			d := dst.Pix[y*dst.Stride+x*4:]
+			for c := 0; c < 4; c++ {
+				d[c] = uint8(sum[c] / n)
+			}
+		}
+	}
+	var out bytes.Buffer
+	if err := jpeg.Encode(&out, dst, &jpeg.Options{Quality: llmImageJPEGQuality}); err != nil {
+		return nil, false
+	}
+	return out.Bytes(), true
+}
