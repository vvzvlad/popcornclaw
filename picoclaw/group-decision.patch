+// respondInGroup decides whether a group message reaches the agent and returns
+// the content to forward. A message that mentions the bot (including /cmd@bot
+// and the bot's own bare commands) always does. A command for another bot or an
+// unknown one never does. Any other message goes to the configured decision
+// model, if any, and otherwise to the group_trigger rules.
+func (c *TelegramChannel) respondInGroup(
+	ctx context.Context,
+	message *telego.Message,
+	content string,
+	isMentioned bool,
+) (bool, string) {
+	decider := c.GroupDecider()
+	var req channels.GroupReplyRequest
+	if decider != nil {
+		req = c.recordGroupMessage(message, content)
+	}
+
+	if isMentioned {
+		return c.ShouldRespondInGroup(true, c.stripBotMention(content))
+	}
+	if startsWithBotCommand(message) {
+		return false, content
+	}
+	if decider != nil {
+		if !c.ShouldRespondByDecision(ctx, telegramChatKey(message.Chat.ID, forumThreadID(message)), req) {
+			return false, content
+		}
+		return true, strings.TrimSpace(content)
+	}
+	return c.ShouldRespondInGroup(false, content)
+}
+
+// recordGroupMessage appends the message to its chat's history and returns the
+// decider request for it, built from the history as it was before the message.
+func (c *TelegramChannel) recordGroupMessage(message *telego.Message, content string) channels.GroupReplyRequest {
+	chatKey := telegramChatKey(message.Chat.ID, forumThreadID(message))
+	history := c.GroupHistory()
+
+	sentAt := time.Now()
+	if message.Date > 0 {
+		sentAt = time.Unix(message.Date, 0)
+	}
+	from := c.groupSenderName(message)
+
+	req := channels.GroupReplyRequest{
+		BotUsername: c.bot.Username(),
+		Now:         sentAt,
+		Message:     channels.GroupMessage{From: from, Text: content},
+		History:     history.Recent(chatKey, message.MessageID, sentAt),
+	}
+	if last, ok := history.LastBot(chatKey, message.MessageID); ok {
+		req.BotLast = &last
+	}
+	entry := channels.GroupHistoryEntry{MessageID: message.MessageID, From: from, Text: content, Time: sentAt}
+
+	if reply := telegramGroupReplyTarget(message); reply != nil {
+		replyFrom := c.groupSenderName(reply)
+		req.RepliesToBot = c.isOwnBotUser(reply.From)
+		req.RepliedTo = &channels.GroupMessage{From: replyFrom, Text: telegramQuotedContent(reply)}
+		entry.ReplyTo = replyFrom
+	}
+
+	history.Add(chatKey, entry)
+	return req
+}
+
+var _ channels.SentMessageRecorder = (*TelegramChannel)(nil)
+
+// RecordSentMessage implements channels.SentMessageRecorder: a message the bot
+// delivered to a group becomes part of that group's history.
+func (c *TelegramChannel) RecordSentMessage(
+	chatID string,
+	outboundCtx *bus.InboundContext,
+	content string,
+	messageIDs []string,
+) {
+	if len(messageIDs) == 0 {
+		return
+	}
+	tgChatID, threadID, err := resolveTelegramOutboundTarget(chatID, outboundCtx)
+	if err != nil {
+		return
+	}
+	messageID, err := strconv.Atoi(messageIDs[len(messageIDs)-1])
+	if err != nil {
+		return
+	}
+	c.recordOwnGroupMessage(tgChatID, threadID, content, messageID)
+}
+
+// recordOwnGroupMessage appends a message the bot sent to a group (or to one of
+// its forum topics) to the history.
+func (c *TelegramChannel) recordOwnGroupMessage(chatID int64, threadID int, content string, messageID int) {
+	if c.GroupDecider() == nil || chatID >= 0 { // positive chat IDs are private chats
+		return
+	}
+	c.GroupHistory().Add(telegramChatKey(chatID, threadID), channels.GroupHistoryEntry{
+		MessageID: messageID,
+		From:      channels.GroupHistoryBotName,
+		Text:      content,
+		Time:      time.Now(),
+	})
+}
+
+// telegramChatKey identifies a chat, or a forum topic of it, in the history and
+// as the delivery chat ID.
+func telegramChatKey(chatID int64, threadID int) string {
+	if threadID != 0 {
+		return fmt.Sprintf("%d/%d", chatID, threadID)
+	}
+	return strconv.FormatInt(chatID, 10)
+}
+
+// forumThreadID is the forum topic of a message, 0 outside forum topics. Only
+// forum groups have topics; the reply threads of regular groups share one conversation.
+func forumThreadID(message *telego.Message) int {
+	if message.Chat.IsForum {
+		return message.MessageThreadID
+	}
+	return 0
+}
+
+// groupSenderName names the sender of a message for the decider: "bot" for this
+// bot itself, otherwise the user's username or first name.
+func (c *TelegramChannel) groupSenderName(message *telego.Message) string {
+	if message != nil && c.isOwnBotUser(message.From) {
+		return channels.GroupHistoryBotName
+	}
+	return telegramQuotedAuthor(message)
+}
+
+// telegramGroupReplyTarget returns the message that message replies to. In a
+// forum topic every message nominally replies to the topic's first message,
+// which is not a reply by the sender.
+func telegramGroupReplyTarget(message *telego.Message) *telego.Message {
+	reply := message.ReplyToMessage
+	if reply == nil || (message.Chat.IsForum && reply.MessageID == message.MessageThreadID) {
+		return nil
+	}
+	return reply
+}
+
+// startsWithBotCommand reports whether the message begins with a /command, the
+// way a command meant for a bot is written. A command in the middle of a
+// sentence does not make the message a command.
+func startsWithBotCommand(message *telego.Message) bool {
+	text, entities := telegramEntityTextAndList(message)
+	leading := 0
+	for _, r := range text {
+		if !unicode.IsSpace(r) {
+			break
+		}
+		leading++
+	}
+	for _, entity := range entities {
+		if entity.Type == telego.EntityTypeBotCommand && entity.Offset == leading {
+			return true
+		}
+	}
+	return false
+}
+
