+// storeInlineAudio stores a base64 "data:audio/..." payload from the TV remote under the media store and
+// returns its ref. The agent transcribes it like any other audio (utils.IsAudioFile → al.transcriber, the
+// Groq ASR path shared with Telegram voice notes). Returns ok=false when there is no audio or it is unusable.
+func (c *PicoChannel) storeInlineAudio(pc *picoConn, msg PicoMessage) (string, bool) {
+	raw, _ := msg.Payload["audio"].(string)
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return "", false
+	}
+	if !strings.HasPrefix(raw, "data:audio/") {
+		logger.WarnCF("pico", "ignoring non-audio data URL", map[string]any{"head": truncate(raw, 16)})
+		return "", false
+	}
+	header, b64, found := strings.Cut(raw, ",")
+	if !found || !strings.Contains(header, ";base64") {
+		return "", false
+	}
+	data, err := base64.StdEncoding.DecodeString(strings.TrimSpace(b64))
+	if err != nil || len(data) == 0 {
+		logger.WarnCF("pico", "bad audio payload", map[string]any{"error": err})
+		return "", false
+	}
+	store := c.GetMediaStore()
+	if store == nil {
+		return "", false
+	}
+	f, err := os.CreateTemp("", "pico-voice-*.wav")
+	if err != nil {
+		logger.WarnCF("pico", "cannot create temp audio file", map[string]any{"error": err})
+		return "", false
+	}
+	if _, err := f.Write(data); err != nil {
+		f.Close()
+		os.Remove(f.Name())
+		return "", false
+	}
+	f.Close()
+	sessionID := msg.SessionID
+	if sessionID == "" {
+		sessionID = pc.sessionID
+	}
+	scope := channels.BuildMediaScope("pico", "pico:"+sessionID, msg.ID)
+	ref, err := store.Store(f.Name(), media.MediaMeta{
+		Filename:      "voice.wav",
+		ContentType:   "audio/wav",
+		Source:        "pico",
+		CleanupPolicy: media.CleanupPolicyDeleteOnCleanup,
+	}, scope)
+	if err != nil {
+		os.Remove(f.Name())
+		logger.WarnCF("pico", "cannot store audio", map[string]any{"error": err})
+		return "", false
+	}
+	logger.InfoCF("pico", "stored TV voice note", map[string]any{"bytes": len(data), "ref": ref})
+	return ref, true
+}
