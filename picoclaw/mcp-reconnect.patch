+		Servers: map[string]config.MCPServerConfig{
+			"projector": {Enabled: true, URL: "http://127.0.0.1:1/mcp"},
+		},
+	}
+	if err := mgr.LoadFromMCPConfig(context.Background(), mcpCfg, ""); err == nil {
+		t.Fatal("LoadFromMCPConfig() error = nil, want failure of the only server")
+	}
+	mgr.RetryFailedServers(func(string, *ServerConnection) {
+		t.Error("onConnected called for a server that never connects")
+	})
+
+	deadline := time.Now().Add(5 * time.Second)
+	for connectCalls.Load() < 3 {
+		if time.Now().After(deadline) {
+			t.Fatal("no retries happened before Close")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	if err := mgr.Close(); err != nil {
+		t.Fatalf("Close() error = %v", err)
+	}
+	if !mgr.IsClosed() {
+		t.Fatal("IsClosed() = false after Close")
+	}
+	// Let an attempt that was already in flight at Close finish, then require silence.
+	time.Sleep(50 * time.Millisecond)
+	callsAfterClose := connectCalls.Load()
+	time.Sleep(100 * time.Millisecond)
+	if got := connectCalls.Load(); got != callsAfterClose {
+		t.Fatalf("connect calls grew from %d to %d after Close", callsAfterClose, got)
+	}
+}
