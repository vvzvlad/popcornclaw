<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only used by the optional weather pane (Open-Meteo), off by default. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VoiceSearchActivity listens with the in-app SpeechRecognizer (the remote mic). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets "Uninstall" in the tile menu open the system uninstall dialog (the system always asks). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- PopcornClaw: AgentService hears new Bluetooth bonds (their keys can stop a remote reconnecting). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <!-- WireGuard (official app, Apache-2.0): lets the TV menu send SET_TUNNEL_UP / SET_TUNNEL_DOWN when
         "Allow remote control apps" is enabled in the WireGuard app. -->
    <uses-permission android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />

    <!-- Android 11+ package visibility for the speech recognizer and TTS (no effect on Android 8/9). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Send to TV: is there a browser / the YouTube app (castKinds). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.wireguard.android" />
        <!-- App list (Android 11+): TV and phone launcher entries only; no QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home button override (HomeOverride): which activities are the stock home screens. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.dir/channel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="jp.co.sharp.av.android.aquostvapp" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.android.tv" />
        <package android:name="org.dtvkit.inputsource" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.hisense.tv.livetv" />
        <package android:name="com.philips.tv.tvapp" />
        <package android:name="org.droidtv.playtv" />
        <package android:name="org.droidtv.tv" />
        <package android:name="org.droidtv.channels" />
        <package android:name="org.droidtv.zapster" />
        <package android:name="org.droidtv.eum" />
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- PopcornClaw: AgentService pops up each command to the agent over every app; the app-op is granted by
         `make app` (appops set xyz.vvzvlad.popcornclaw SYSTEM_ALERT_WINDOW allow). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".OmarchyApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <!-- PopcornClaw: keeps the PicoClaw gateway (lib/armeabi-v7a or lib/arm64-v8a, libpicoclaw.so) running as root. -->
        <service
            android:name="xyz.vvzvlad.popcornclaw.AgentService"
            android:exported="false" />
        <receiver
            android:name="xyz.vvzvlad.popcornclaw.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Remotes and keyboards that send a voice command or a long Search press open Walker
                 (voiceKey "launcher", the default; Google Assistant when chosen). -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- PopcornClaw: holds the Assistant role and catches ACTION_ASSIST. The phone remote's ASSIST carries the
             decoded-audio binder: this activity captures it silently (translucent, own task, finishes in onCreate)
             so the playing video stays on screen instead of dropping to the launcher. A binder-less ASSIST
             (KEYCODE_ASSIST from other remotes) is handed to MainActivity's Walker voice path. -->
        <activity
            android:name="xyz.vvzvlad.popcornclaw.VoiceAssistActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VoiceCapture">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- PopcornClaw: the Bluetooth voice remote's mic key (KEYCODE_VOICE_ASSIST) starts WEB_SEARCH; this activity
             recognizes the speech in-app and sends it to the agent instead of Google search. No noHistory: leaving
             with HOME mid-sentence still sends what was heard. -->
        <activity
            android:name="xyz.vvzvlad.popcornclaw.VoiceSearchActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VoiceCapture">
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Web apps: own process, so the launcher never holds a WebView; the process exits with the web app. -->
        <activity
            android:name=".WebAppActivity"
            android:process=":web"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />

        <!-- After a reboot: if the stock launcher took the home screen back, ask once (never changes it). -->
        <receiver
            android:name=".HomeCheck"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Crash watchdog: own process so it survives the launcher crashing (3 crashes in 5 min = stock home back). -->
        <service
            android:name=".Watchdog$RevertService"
            android:process=":watchdog"
            android:exported="false" />

        <!-- v2.10: the screensaver window (idle on home + preview) runs in its own process. -->
        <activity
            android:name=".ScreensaverPreviewActivity"
            android:process=":saver"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />

        <!-- System screensavers: disabled by default. The launcher shows its own screensaver only while idle on
             the home screen; Screensaver → "Also use as system screensaver" enables these components.
             Android runs them only after the idle timeout, never over playing video.
             Pick one in Settings, or over adb:
             settings put secure screensaver_components xyz.vvzvlad.popcornclaw/com.omarchytv.home.OmarchyDream
             settings put secure screensaver_enabled 1 -->
        <!-- v2.10: enabled so DreamManager can find it (Android 9 reported "does not exist" while the component
             was disabled); it still runs only if picked as the TV's screensaver.
             #57: no android:process here. On Android 11+ the system's DreamActivity runs in the app's main process and
             casts the service's callback Binder directly, so a dream in ":saver" crashed with a ClassCastException. -->
        <service
            android:name=".OmarchyDream"
            android:label="@string/dream_omarchy"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Optional: Home opens OmarchyTV where the TV won't let it be the default home (Google TV). Off until enabled. -->
        <service
            android:name=".HomeOverride"
            android:label="@string/home_service"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_accessibility" />
        </service>

        <!-- Optional: remote key bindings (omarchytv.json "keys"). The accessibility key filter sees a key before the
             system's own hooks (e.g. the SHIELD Netflix button), which is the only way to remap it from an app.
             Off until the user enables it; keys without bindings are never consumed. -->
        <service
            android:name=".KeyMapService"
            android:label="@string/keymap_service"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keymap_accessibility" />
        </service>

        <service
            android:name=".ClockDream"
            android:enabled="false"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
