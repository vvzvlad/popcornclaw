+)
+
+func testConfig() config.GroupDecisionConfig {
+	return config.GroupDecisionConfig{
+		Model:           "typesafe/jev-1.14",
+		APIKey:          *config.NewSecureString("test-key"),
+		BotDescription:  "BOT DOES",
+		ChatDescription: "CHAT DESC",
+	}
+}
+
+func newTestClient(t *testing.T, cfg config.GroupDecisionConfig, handler http.HandlerFunc) *Client {
+	t.Helper()
+	srv := httptest.NewServer(handler)
+	t.Cleanup(srv.Close)
+	c, err := New(cfg)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	c.endpoint = srv.URL
+	return c
+}
+
+// goldenRequest is the input of testdata/request.golden.json. The golden has the
+// shape of the request that was validated against the real API; its data is synthetic.
+func goldenRequest() channels.GroupReplyRequest {
+	now := time.Date(2026, 9, 6, 12, 0, 0, 0, time.UTC)
+	return channels.GroupReplyRequest{
+		BotUsername:  "asakusaclawbot",
+		RepliesToBot: true,
+		Now:          now,
+		Message:      channels.GroupMessage{From: "alice", Text: "  /print please? <b>привет</b> & co  "},
+		RepliedTo:    &channels.GroupMessage{From: "bot", Text: "Done ✅"},
+		History: []channels.GroupHistoryEntry{
+			{From: "bob", Text: strings.Repeat("x", 350), Time: now.Add(-30 * time.Minute)},
+			{From: "bot", Text: "Done ✅", Time: now.Add(-5 * time.Minute), ReplyTo: "alice"},
+			{From: "alice", Text: "ок", Time: now.Add(-time.Minute), ReplyTo: "bot"},
+		},
+		BotLast: &channels.GroupHistoryEntry{From: "bot", Text: "Done ✅", Time: now.Add(-5 * time.Minute)},
+	}
+}
+
+func TestRequestBodyMatchesGolden(t *testing.T) {
+	var gotBody []byte
+	var gotAuth, gotPath string
+	c := newTestClient(t, testConfig(), func(w http.ResponseWriter, r *http.Request) {
+		gotBody, _ = io.ReadAll(r.Body)
+		gotAuth = r.Header.Get("Authorization")
+		gotPath = r.Method + " " + r.URL.Path
+		_, _ = io.WriteString(w, `{"answers":{"addressed":{"type":"noul","noul":0.87}}}`)
+	})
+
+	p, err := c.ReplyProbability(context.Background(), goldenRequest())
+	if err != nil {
+		t.Fatalf("ReplyProbability: %v", err)
+	}
+	if p != 0.87 {
+		t.Fatalf("probability = %v, want 0.87", p)
+	}
+	if gotAuth != "Bearer test-key" || gotPath != "POST /" {
+		t.Fatalf("auth=%q request=%q", gotAuth, gotPath)
+	}
+
+	golden, err := os.ReadFile("testdata/request.golden.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want, got any
+	if err := json.Unmarshal(golden, &want); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(gotBody, &got); err != nil {
+		t.Fatalf("request is not JSON: %v\n%s", err, gotBody)
+	}
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("request differs from golden\n got: %s\nwant: %s", gotBody, golden)
+	}
+	if !strings.Contains(string(gotBody), "<b>привет</b> & co") {
+		t.Fatalf("request escapes HTML or non-ASCII characters: %s", gotBody)
+	}
+}
+
+func TestRequestBodyWithoutReplyHistoryOrBotMessage(t *testing.T) {
+	c, err := New(testConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := c.requestBody(channels.GroupReplyRequest{
+		BotUsername: "@mybot",
+		Now:         time.Now(),
+		Message:     channels.GroupMessage{From: "alice", Text: "hi"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got struct {
+		State struct {
+			Bot            struct{ Username string }
+			RecentMessages []any `json:"recent_messages"`
+			BotLastMessage any   `json:"bot_last_message"`
+			Message        map[string]any
+		}
+		Questions map[string]struct {
+			Instructions string
+			Criteria     map[string]string
+		}
+	}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.State.Bot.Username != "@mybot" {
+		t.Errorf("username = %q, want @mybot", got.State.Bot.Username)
+	}
+	if got.State.RecentMessages == nil || len(got.State.RecentMessages) != 0 {
+		t.Errorf("recent_messages = %#v, want empty array", got.State.RecentMessages)
+	}
+	if got.State.BotLastMessage != "none" {
+		t.Errorf("bot_last_message = %#v, want \"none\"", got.State.BotLastMessage)
+	}
+	if v, ok := got.State.Message["replies_to"]; !ok || v != nil {
+		t.Errorf("replies_to = %#v (present=%v), want null", v, ok)
+	}
+	if got.State.Message["replies_to_the_bot"] != false {
+		t.Errorf("replies_to_the_bot = %#v, want false", got.State.Message["replies_to_the_bot"])
+	}
+	q := got.Questions["addressed"]
+	if !strings.Contains(q.Instructions, "the bot @mybot (") {
+		t.Errorf("instructions do not name the bot: %q", q.Instructions)
+	}
+	for _, k := range []string{"true", "false"} {
+		if _, ok := q.Criteria[k]; !ok {
+			t.Errorf("criteria lack key %q: %v", k, q.Criteria)
+		}
+	}
+}
+
+func TestAgeWords(t *testing.T) {
+	tests := []struct {
+		age  time.Duration
+		want string
+	}{
+		{0, "just now"},
+		{119 * time.Second, "just now"},
+		{2 * time.Minute, "a few minutes earlier"},
+		{14*time.Minute + 59*time.Second, "a few minutes earlier"},
+		{15 * time.Minute, "within the last hour"},
+		{59 * time.Minute, "within the last hour"},
+		{time.Hour, "hours earlier"},
+		{23 * time.Hour, "hours earlier"},
+		{24 * time.Hour, "days earlier"},
+	}
+	for _, tc := range tests {
+		if got := ageWords(tc.age); got != tc.want {
+			t.Errorf("ageWords(%v) = %q, want %q", tc.age, got, tc.want)
+		}
+	}
+}
+
+func TestCapText(t *testing.T) {
+	if got := capText("  привет  ", 6); got != "привет" {
+		t.Errorf("trimmed = %q", got)
+	}
+	if got := capText("привет!", 6); got != "привет…" {
+		t.Errorf("capped = %q", got)
+	}
+}
+
+func TestReplyProbabilityErrors(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.HandlerFunc
+		timeout int
+	}{
+		{
+			name: "http error",
+			handler: func(w http.ResponseWriter, _ *http.Request) {
+				http.Error(w, "forbidden region", http.StatusForbidden)
+			},
+		},
+		{
+			name: "invalid json",
+			handler: func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = io.WriteString(w, "not json")
+			},
+		},
+		{
+			name: "no addressed answer",
+			handler: func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = io.WriteString(w, `{"answers":{}}`)
+			},
+		},
+		{
+			name: "answer is not a noul",
+			handler: func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = io.WriteString(w, `{"answers":{"addressed":{"type":"choice","selected":"a"}}}`)
+			},
+		},
+		{
+			name: "timeout",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				select {
+				case <-time.After(2 * time.Second):
+				case <-r.Context().Done():
+				}
+			},
+			timeout: 50,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := testConfig()
+			cfg.TimeoutMS = tc.timeout
+			c := newTestClient(t, cfg, tc.handler)
+			if p, err := c.ReplyProbability(context.Background(), goldenRequest()); err == nil {
+				t.Fatalf("want error, got probability %v", p)
+			}
+		})
+	}
+}
+
+func TestNewRejectsBadProxy(t *testing.T) {
+	cfg := testConfig()
+	cfg.Proxy = "ftp://proxy.example"
+	if _, err := New(cfg); err == nil {
+		t.Fatal("want error for unsupported proxy scheme")
+	}
+}
