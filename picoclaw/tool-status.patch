+// requiredNames flattens a schema "required" value ([]string or []any) to strings.
+func requiredNames(t *testing.T, v any) []string {
+	t.Helper()
+	switch req := v.(type) {
+	case nil:
+		return nil
+	case []string:
+		return req
+	case []any:
+		names := make([]string, 0, len(req))
+		for _, item := range req {
+			name, ok := item.(string)
+			if !ok {
+				t.Fatalf("required item %#v is not a string", item)
+			}
+			names = append(names, name)
+		}
+		return names
+	default:
+		t.Fatalf("required = %#v (%T), want []string or []any", v, v)
+		return nil
+	}
+}
+
+func TestToolRegistry_ToProviderDefsAddsRequiredStatusParam(t *testing.T) {
+	tests := []struct {
+		name string
+		// params builds a fresh schema on every call, so the registered copy can be
+		// compared against a pristine one after ToProviderDefs.
+		params func() map[string]any
+	}{
+		{
+			name: "required as []string",
+			params: func() map[string]any {
+				return map[string]any{
+					"type": "object",
+					"properties": map[string]any{
+						"path": map[string]any{"type": "string"},
+					},
+					// Spare capacity exposes an in-place append into the tool's slice.
+					"required": append(make([]string, 0, 4), "path"),
+				}
+			},
+		},
+		{
+			name: "required as []any",
+			params: func() map[string]any {
+				return map[string]any{
+					"type": "object",
+					"properties": map[string]any{
+						"query": map[string]any{"type": "string"},
+						"limit": map[string]any{"type": "integer"},
+					},
+					"required": append(make([]any, 0, 4), "query"),
+				}
+			},
+		},
+		{
+			name: "without properties and required",
+			params: func() map[string]any {
+				return map[string]any{"type": "object"}
+			},
+		},
+		{
+			name: "additionalProperties false",
+			params: func() map[string]any {
+				return map[string]any{
+					"type": "object",
+					"properties": map[string]any{
+						"value": map[string]any{"type": "string"},
+					},
+					"required":             []string{"value"},
+					"additionalProperties": false,
+				}
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			params := tt.params()
+			r := NewToolRegistry()
+			r.Register(&mockRegistryTool{
+				name:   "probe",
+				desc:   "schema probe",
+				params: params,
+				result: SilentResult("ok"),
+			})
+
+			defs := r.ToProviderDefs()
+			if len(defs) != 1 {
+				t.Fatalf("expected 1 provider def, got %d", len(defs))
+			}
+			got := defs[0].Function.Parameters
+			want := tt.params()
+
+			props, ok := got["properties"].(map[string]any)
+			if !ok {
+				t.Fatalf("properties = %#v, want a map", got["properties"])
+			}
+			status, ok := props[ToolStatusArg].(map[string]any)
+			if !ok || status["type"] != "string" {
+				t.Fatalf("properties[%q] = %#v, want a string schema", ToolStatusArg, props[ToolStatusArg])
+			}
+
+			required := requiredNames(t, got["required"])
+			if !slices.Contains(required, ToolStatusArg) {
+				t.Fatalf("required = %v, want it to contain %q", required, ToolStatusArg)
+			}
+
+			// The tool's own fields survive: required names, properties, other keys.
+			for _, name := range requiredNames(t, want["required"]) {
+				if !slices.Contains(required, name) {
+					t.Errorf("required = %v, want it to keep %q", required, name)
+				}
+			}
+			wantProps, _ := want["properties"].(map[string]any)
+			for name, schema := range wantProps {
+				if !reflect.DeepEqual(props[name], schema) {
+					t.Errorf("properties[%q] = %#v, want %#v", name, props[name], schema)
+				}
+			}
+			for key, value := range want {
+				if key == "properties" || key == "required" {
+					continue
+				}
+				if !reflect.DeepEqual(got[key], value) {
+					t.Errorf("%s = %#v, want %#v", key, got[key], value)
+				}
+			}
+
+			// The tool's own schema is not mutated, including spare slice capacity.
+			if !reflect.DeepEqual(params, want) {
+				t.Errorf("Parameters() mutated to %#v, want %#v", params, want)
+			}
+			switch req := params["required"].(type) {
+			case []string:
+				if slices.Contains(req[:cap(req)], ToolStatusArg) {
+					t.Errorf("Parameters() required backing array got %q", ToolStatusArg)
+				}
+			case []any:
+				if slices.Contains(req[:cap(req)], any(ToolStatusArg)) {
+					t.Errorf("Parameters() required backing array got %q", ToolStatusArg)
+				}
+			}
+		})
+	}
+}
