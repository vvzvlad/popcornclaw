+++ b/pkg/session/shared_session_test.go
@@ -0,0 +1,32 @@
+package session
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/routing"
+)
+
+// The session section in config.json must not move the owner's Telegram DM to a new key: its history
+// lives under v=1|agent=main|channel=telegram|account=default|chat=direct:11111111.
+func TestSharedSession_ConfigSessionSectionKeepsTelegramKey(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	data := `{"version": 3, "session": {"identity_links": {"owner": ["telegram:11111111", "pico:tv"]}}}`
+	if err := os.WriteFile(path, []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatalf("LoadConfig: %v", err)
+	}
+	dm := bus.InboundContext{Channel: "telegram", ChatID: "11111111", ChatType: "direct", SenderID: "11111111"}
+	route := routing.NewRouteResolver(cfg).ResolveRoute(dm)
+	got := AllocateRouteSession(AllocationInput{AgentID: route.AgentID, Context: dm, SessionPolicy: route.SessionPolicy})
+	const want = "sk_v1_bd60789427ad9577ade505cafb5f771d7d4107adb48458ad1d326f5ce7e89556"
+	if got.SessionKey != want {
+		t.Fatalf("Telegram DM SessionKey = %q, want unchanged %q", got.SessionKey, want)
+	}
+}
