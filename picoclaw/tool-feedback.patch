--- /dev/null
+++ b/pkg/channels/tool_feedback_noanim_test.go
@@ -0,0 +1,28 @@
+package channels
+
+import (
+	"context"
+	"testing"
+)
+
+// A recorded step is not animated: an animation frame ("." or "..") would stay glued to the
+// step text once the next step arrives.
+func TestToolFeedbackAnimator_RecordDoesNotAnimate(t *testing.T) {
+	a := NewToolFeedbackAnimator(func(context.Context, string, string, string) error {
+		t.Error("animation edited the step")
+		return nil
+	})
+	a.Record("chat-1", "msg-1", "Смотрю файлы (`mcp_tv_files`)")
+
+	a.mu.Lock()
+	entry := a.entries["chat-1"]
+	a.mu.Unlock()
+	if entry == nil {
+		t.Fatal("step was not recorded")
+	}
+	select {
+	case <-entry.done:
+	default:
+		t.Fatal("animation goroutine is running")
+	}
+}
