new file mode 100644
index 0000000..5103bf7
--- /dev/null
+++ b/pkg/providers/common/error_body_test.go
@@ -0,0 +1,67 @@
+package common
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sipeed/picoclaw/pkg/logger"
+)
+
+// A 400 from nano-gpt reached the log cut at 128 bytes, right before the value of its "code" field.
+// The body below is synthetic, shaped like that response and longer than the old
+// 256-byte read limit; the real code of that 400 is unknown.
+func TestHandleErrorResponse_LogsWholeBodyKeepsShortErrorText(t *testing.T) {
+	body := `{"error":{"message":"Invalid request parameters. Please check your input and try again. ` +
+		strings.Repeat("Details of the rejected field follow. ", 6) +
+		`","type":"invalid_request_error","code":"synthetic_code_at_the_end"}}`
+	if len(body) <= 256 {
+		t.Fatalf("test body must exceed the old 256-byte read limit, got %d bytes", len(body))
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = w.Write([]byte(body))
+	}))
+	defer server.Close()
+
+	logPath := filepath.Join(t.TempDir(), "gateway.log")
+	if err := logger.EnableFileLogging(logPath); err != nil {
+		t.Fatalf("EnableFileLogging: %v", err)
+	}
+	defer logger.DisableFileLogging()
+
+	resp, err := http.Get(server.URL)
+	if err != nil {
+		t.Fatalf("http.Get() error = %v", err)
+	}
+	defer resp.Body.Close()
+
+	err = HandleErrorResponse(resp, server.URL)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	// Retry and compaction decisions match substrings of this text: it must stay the 128-byte preview.
+	if want := "API request failed:\n  Status: 400\n  Body:   " + body[:128] + "..."; err.Error() != want {
+		t.Fatalf("error text = %q, want %q", err.Error(), want)
+	}
+
+	data, readErr := os.ReadFile(logPath)
+	if readErr != nil {
+		t.Fatalf("read log: %v", readErr)
+	}
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		var entry map[string]any
+		if json.Unmarshal([]byte(line), &entry) != nil {
+			continue
+		}
+		if entry["message"] == "Provider error response" && entry["body"] == body {
+			return
+		}
+	}
+	t.Fatalf("log has no entry with the whole error body; log:\n%s", data)
+}
