+// HasFailedServers reports whether some server failed to connect and is still waiting to be retried.
+func (m *Manager) HasFailedServers() bool {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	return len(m.failed) > 0
+}
+
+// IsClosed reports whether the manager has been closed.
+func (m *Manager) IsClosed() bool {
+	return m.closed.Load()
+}
+
+// RetryFailedServers starts one goroutine per server that failed to connect in LoadFromMCPConfig.
+// Each retries with a growing delay until it connects or the manager is closed; onConnected is
+// called with the new connection. It returns the number of goroutines started.
+func (m *Manager) RetryFailedServers(onConnected func(name string, conn *ServerConnection)) int {
+	m.mu.RLock()
+	pending := make(map[string]config.MCPServerConfig, len(m.failed))
+	for name, cfg := range m.failed {
+		pending[name] = cfg
+	}
+	m.mu.RUnlock()
+
+	// Read once here: the goroutines outlive Close and must not touch the package variables.
+	firstDelay, maxDelay := retryFirstDelay, retryMaxDelay
+	for name, cfg := range pending {
+		go m.retryServer(name, cfg, firstDelay, maxDelay, onConnected)
+	}
+	return len(pending)
+}
+
+func (m *Manager) retryServer(
+	name string,
+	cfg config.MCPServerConfig,
+	firstDelay, maxDelay time.Duration,
+	onConnected func(name string, conn *ServerConnection),
+) {
+	delay := firstDelay
+	for {
+		timer := time.NewTimer(delay)
+		select {
+		case <-m.done:
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+
+		// Background on purpose: a stdio server's process is bound to the connect context
+		// (exec.CommandContext), so a request-scoped context would kill it later.
+		err := m.ConnectServer(context.Background(), name, cfg)
+		if err == nil {
+			break
+		}
+		if m.IsClosed() {
+			return
+		}
+		delay = min(delay*2, maxDelay)
+		logger.WarnCF("mcp", "Retry to connect to MCP server failed",
+			map[string]any{
+				"server":     name,
+				"error":      err.Error(),
+				"next_retry": delay.String(),
+			})
+	}
+
+	m.mu.Lock()
+	delete(m.failed, name)
+	conn, ok := m.servers[name]
+	m.mu.Unlock()
+	if !ok {
+		return
+	}
+	logger.InfoCF("mcp", "Connected to MCP server after retry",
+		map[string]any{
+			"server": name,
+		})
+	onConnected(name, conn)
+}
