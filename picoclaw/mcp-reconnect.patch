+func shortenRetryDelays(t *testing.T) {
+	t.Helper()
+	originalFirst, originalMax := retryFirstDelay, retryMaxDelay
+	retryFirstDelay, retryMaxDelay = 5*time.Millisecond, 20*time.Millisecond
+	t.Cleanup(func() {
+		retryFirstDelay, retryMaxDelay = originalFirst, originalMax
+	})
+}
+
+func TestRetryFailedServers_ConnectsServerThatWasDown(t *testing.T) {
+	originalConnectServerFunc := connectServerFunc
+	t.Cleanup(func() {
+		connectServerFunc = originalConnectServerFunc
+	})
+	shortenRetryDelays(t)
+
+	upConn, _, err := newScriptedServerConnection("session-1", nil, nil)
+	if err != nil {
+		t.Fatalf("newScriptedServerConnection() error = %v", err)
+	}
+
+	var connectCalls atomic.Int32
+	connectServerFunc = func(ctx context.Context, name string, cfg config.MCPServerConfig) (*ServerConnection, error) {
+		if connectCalls.Add(1) <= 2 {
+			return nil, fmt.Errorf("connection refused")
+		}
+		return upConn, nil
+	}
+
+	mgr := NewManager()
+	defer mgr.Close()
+
+	mcpCfg := config.MCPConfig{
+		ToolConfig: config.ToolConfig{Enabled: true},
+		Servers: map[string]config.MCPServerConfig{
+			"projector": {Enabled: true, URL: "http://127.0.0.1:1/mcp"},
+		},
+	}
+	if err := mgr.LoadFromMCPConfig(context.Background(), mcpCfg, ""); err == nil {
+		t.Fatal("LoadFromMCPConfig() error = nil, want failure of the only server")
+	}
+	if !mgr.HasFailedServers() {
+		t.Fatal("HasFailedServers() = false, want true after the failed connect")
+	}
+
+	connected := make(chan *ServerConnection, 1)
+	started := mgr.RetryFailedServers(func(name string, conn *ServerConnection) {
+		if name != "projector" {
+			t.Errorf("onConnected name = %q, want %q", name, "projector")
+		}
+		connected <- conn
+	})
+	if started != 1 {
+		t.Fatalf("RetryFailedServers() = %d, want 1", started)
+	}
+
+	select {
+	case conn := <-connected:
+		if conn != upConn {
+			t.Fatalf("onConnected conn = %p, want %p", conn, upConn)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("onConnected was not called")
+	}
+	if got, ok := mgr.GetServer("projector"); !ok || got != upConn {
+		t.Fatalf("GetServer() = %p, %v, want the connection made by the retry", got, ok)
+	}
+	if mgr.HasFailedServers() {
+		t.Fatal("HasFailedServers() = true, want false after the retry succeeded")
+	}
+	if got := connectCalls.Load(); got != 3 {
+		t.Fatalf("connect calls = %d, want 3 (initial, one failed retry, successful retry)", got)
+	}
+}
