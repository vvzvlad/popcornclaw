+
+type toolStatusProvider struct {
+	calls int
+}
+
+func (m *toolStatusProvider) Chat(
+	ctx context.Context,
+	messages []providers.Message,
+	defs []providers.ToolDefinition,
+	model string,
+	opts map[string]any,
+) (*providers.LLMResponse, error) {
+	m.calls++
+	if m.calls == 1 {
+		return &providers.LLMResponse{
+			ToolCalls: []providers.ToolCall{{
+				ID:   "call_status_probe",
+				Type: "function",
+				Name: "status_probe",
+				Arguments: map[string]any{
+					"status": "Проверяю, что статус доходит до чата",
+					"value":  "x",
+				},
+			}},
+		}, nil
+	}
+	return &providers.LLMResponse{Content: "DONE"}, nil
+}
+
+func (m *toolStatusProvider) GetDefaultModel() string {
+	return "tool-status-model"
+}
+
+// statusProbeTool has a strict schema without "status" and records the args it gets.
+type statusProbeTool struct {
+	mu   sync.Mutex
+	args map[string]any
+}
+
+func (t *statusProbeTool) Name() string { return "status_probe" }
+
+func (t *statusProbeTool) Description() string { return "records its arguments" }
+
+func (t *statusProbeTool) Parameters() map[string]any {
+	return map[string]any{
+		"type": "object",
+		"properties": map[string]any{
+			"value": map[string]any{"type": "string"},
+		},
+		"required": []string{"value"},
+	}
+}
+
+func (t *statusProbeTool) Execute(_ context.Context, args map[string]any) *tools.ToolResult {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.args = args
+	return tools.NewToolResult("ok")
+}
+
+func TestProcessMessage_ToolStatusArgBecomesFeedbackAndIsStripped(t *testing.T) {
+	cfg := &config.Config{
+		Agents: config.AgentsConfig{
+			Defaults: config.AgentDefaults{
+				Workspace:         t.TempDir(),
+				ModelName:         "test-model",
+				MaxTokens:         4096,
+				MaxToolIterations: 10,
+				ToolFeedback: config.ToolFeedbackConfig{
+					Enabled:       true,
+					MaxArgsLength: 300,
+				},
+			},
+		},
+	}
+
+	msgBus := bus.NewMessageBus()
+	al := NewAgentLoop(cfg, msgBus, &toolStatusProvider{})
+	probe := &statusProbeTool{}
+	al.RegisterTool(probe)
+
+	response, err := al.processMessage(context.Background(), testInboundMessage(bus.InboundMessage{
+		Channel:  "telegram",
+		SenderID: "user-1",
+		ChatID:   "chat-1",
+		Content:  "сделай что-нибудь",
+	}))
+	if err != nil {
+		t.Fatalf("processMessage() error = %v", err)
+	}
+	if response != "DONE" {
+		t.Fatalf("processMessage() response = %q, want %q", response, "DONE")
+	}
+
+	probe.mu.Lock()
+	gotArgs := probe.args
+	probe.mu.Unlock()
+	if gotArgs == nil {
+		t.Fatal("status_probe was not executed")
+	}
+	if _, ok := gotArgs["status"]; ok {
+		t.Fatalf("tool args = %v, want status stripped", gotArgs)
+	}
+	if gotArgs["value"] != "x" {
+		t.Fatalf("tool args = %v, want value=x", gotArgs)
+	}
+
+	select {
+	case outbound := <-msgBus.OutboundChan():
+		want := "\U0001f527 `status_probe`\nПроверяю, что статус доходит до чата"
+		if outbound.Content != want {
+			t.Fatalf("tool feedback content = %q, want %q", outbound.Content, want)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("expected outbound tool feedback")
+	}
+}
+
+func TestToolFeedbackExplanationForToolCall_StatusArgWins(t *testing.T) {
+	toolCall := providers.ToolCall{
+		ID:   "call_1",
+		Name: "read_file",
+		Arguments: map[string]any{
+			tools.ToolStatusArg: "  Читаю конфиг, чтобы найти порт  ",
+			"path":              "config.json",
+		},
+		ExtraContent: &providers.ExtraContent{
+			ToolFeedbackExplanation: "Explanation from extra content",
+		},
+	}
+	response := &providers.LLMResponse{
+		Content:   "Explanation from response content",
+		ToolCalls: []providers.ToolCall{toolCall},
+	}
+
+	got := toolFeedbackExplanationForToolCall(response, toolCall, nil)
+	want := "Читаю конфиг, чтобы найти порт"
+	if got != want {
+		t.Fatalf("toolFeedbackExplanationForToolCall() = %q, want %q", got, want)
+	}
+}
