+func TestGroupDecision_HistoryFollowsMessageIDsNotArrival(t *testing.T) {
+	spy := &spyDecider{p: 0}
+	ch, _ := newGroupDecisionChannel(t, spy)
+
+	// Telegram handles updates concurrently: message 12 is recorded before 11 and 10.
+	for _, id := range []int{12, 10, 11} {
+		if err := ch.handleMessage(context.Background(), groupMessage(id, 7, fmt.Sprintf("message %d", id))); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var histories [][]string
+	for _, req := range spy.requests {
+		var texts []string
+		for _, e := range req.History {
+			texts = append(texts, e.Text)
+		}
+		histories = append(histories, texts)
+	}
+	want := [][]string{
+		nil,            // 12: nothing known yet
+		nil,            // 10: 12 is later and must not leak in
+		{"message 10"}, // 11: 12 is later and must not leak in
+	}
+	if fmt.Sprint(histories) != fmt.Sprint(want) {
+		t.Fatalf("histories = %q, want %q", histories, want)
+	}
+	if got := ch.GroupHistory().Recent(testGroupChatKey, 100, time.Now()); len(got) != 3 ||
+		got[0].MessageID != 10 || got[1].MessageID != 11 || got[2].MessageID != 12 {
+		t.Fatalf("stored history = %+v, want ids 10 11 12", got)
+	}
+}
