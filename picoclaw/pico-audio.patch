@@ -0,0 +1,67 @@
+package pico
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/media"
+	"github.com/sipeed/picoclaw/pkg/utils"
+)
+
+// A voice note from the TV remote arrives as a base64 "data:audio/..." URL in message.send. The channel
+// stores it as audio and marks the message [voice], so the agent transcribes it on the same Groq ASR path as
+// a Telegram voice note (and shared-session mirrors the recognized text to Telegram).
+func TestHandleMessageSend_StoresTVVoiceNote(t *testing.T) {
+	msgBus := bus.NewMessageBus()
+	bc := &config.Channel{Type: config.ChannelPico, Enabled: true}
+	cfg := &config.PicoSettings{}
+	cfg.SetToken("test-token")
+	ch, err := NewPicoChannel(bc, cfg, msgBus)
+	if err != nil {
+		t.Fatalf("NewPicoChannel: %v", err)
+	}
+	ch.ctx = context.Background()
+	store := media.NewFileMediaStore()
+	ch.SetMediaStore(store)
+
+	wav := []byte("RIFF\x00\x00\x00\x00WAVEfake pcm payload")
+	dataURL := "data:audio/wav;base64," + base64.StdEncoding.EncodeToString(wav)
+	ch.handleMessageSend(&picoConn{id: "c1", sessionID: "tv"}, PicoMessage{
+		Type:      TypeMessageSend,
+		ID:        "m1",
+		SessionID: "tv",
+		Payload:   map[string]any{"audio": dataURL},
+	})
+
+	select {
+	case inbound := <-msgBus.InboundChan():
+		if inbound.Content != "[voice]" {
+			t.Fatalf("content = %q, want [voice]", inbound.Content)
+		}
+		if len(inbound.Media) != 1 {
+			t.Fatalf("media refs = %d, want 1", len(inbound.Media))
+		}
+		path, meta, err := store.ResolveWithMeta(inbound.Media[0])
+		if err != nil {
+			t.Fatalf("ResolveWithMeta: %v", err)
+		}
+		if !utils.IsAudioFile(meta.Filename, meta.ContentType) {
+			t.Fatalf("stored media not audio: filename=%q content_type=%q", meta.Filename, meta.ContentType)
+		}
+		got, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("read stored file: %v", err)
+		}
+		if !bytes.Equal(got, wav) {
+			t.Fatalf("stored bytes = %d, want %d", len(got), len(wav))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("expected an inbound pico voice message")
+	}
+}
