+func TestManager_NamedInstances(t *testing.T) {
+	chans := config.ChannelsConfig{
+		"zakhar_a": {
+			Type:     config.ChannelWebhook,
+			Enabled:  true,
+			Settings: config.RawNode(`{"path":"/hooks/a","secret":"secret-a","send_url":"http://127.0.0.1/a"}`),
+		},
+		"zakhar_b": {
+			Type:     config.ChannelWebhook,
+			Enabled:  true,
+			Settings: config.RawNode(`{"secret":"secret-b","send_url":"http://127.0.0.1/b"}`),
+		},
+		"no_secret": {
+			Type:     config.ChannelWebhook,
+			Enabled:  true,
+			Settings: config.RawNode(`{"send_url":"http://127.0.0.1/c"}`),
+		},
+	}
+	require.NoError(t, config.InitChannelList(chans))
+
+	m, err := channels.NewManager(&config.Config{Channels: chans}, bus.NewMessageBus(), nil)
+	require.NoError(t, err)
+
+	paths := map[string]string{}
+	for _, name := range []string{"zakhar_a", "zakhar_b"} {
+		ch, ok := m.GetChannel(name)
+		require.True(t, ok, name)
+		assert.Equal(t, name, ch.Name())
+		paths[name] = ch.(channels.WebhookHandler).WebhookPath()
+	}
+	assert.Equal(t, map[string]string{"zakhar_a": "/hooks/a", "zakhar_b": "/webhook/zakhar_b"}, paths)
+
+	_, ok := m.GetChannel("no_secret")
+	assert.False(t, ok)
+}
