+package channels
+
+import (
+	"context"
+	"testing"
+
+	"golang.org/x/time/rate"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+)
+
+type sentRecord struct {
+	chatID     string
+	content    string
+	messageIDs []string
+}
+
+// sentRecorderChannel delivers with fixed message IDs and records what the
+// Manager reports as delivered.
+type sentRecorderChannel struct {
+	mockMediaChannel
+	sendIDs  []string
+	mediaIDs []string
+	sent     int
+	recorded []sentRecord
+}
+
+func (c *sentRecorderChannel) Send(_ context.Context, _ bus.OutboundMessage) ([]string, error) {
+	c.sent++
+	return c.sendIDs, nil
+}
+
+func (c *sentRecorderChannel) SendMedia(_ context.Context, _ bus.OutboundMediaMessage) ([]string, error) {
+	return c.mediaIDs, nil
+}
+
+func (c *sentRecorderChannel) RecordSentMessage(
+	chatID string,
+	_ *bus.InboundContext,
+	content string,
+	messageIDs []string,
+) {
+	c.recorded = append(c.recorded, sentRecord{chatID, content, messageIDs})
+}
+
+func newSentRecorderManager(ch *sentRecorderChannel) (*Manager, *channelWorker) {
+	m := newTestManager()
+	w := &channelWorker{ch: ch, limiter: rate.NewLimiter(rate.Inf, 1)}
+	m.channels["test"] = ch
+	m.workers["test"] = w
+	return m, w
+}
+
+func assertRecorded(t *testing.T, ch *sentRecorderChannel, want ...sentRecord) {
+	t.Helper()
+	if len(ch.recorded) != len(want) {
+		t.Fatalf("recorded %+v, want %+v", ch.recorded, want)
+	}
+	for i, w := range want {
+		got := ch.recorded[i]
+		if got.chatID != w.chatID || got.content != w.content || len(got.messageIDs) != len(w.messageIDs) ||
+			(len(w.messageIDs) > 0 && got.messageIDs[0] != w.messageIDs[0]) {
+			t.Fatalf("recorded[%d] = %+v, want %+v", i, got, w)
+		}
+	}
+}
+
+func TestSendWithRetry_RecordsDeliveredMessage(t *testing.T) {
+	ch := &sentRecorderChannel{sendIDs: []string{"11"}}
+	m, w := newSentRecorderManager(ch)
+
+	m.sendWithRetry(context.Background(), "test", w,
+		testOutboundMessage(bus.OutboundMessage{Channel: "test", ChatID: "123", Content: "hello"}))
+
+	assertRecorded(t, ch, sentRecord{"123", "hello", []string{"11"}})
+}
+
+// With the default placeholder the answer is delivered by editing the
+// placeholder and Send is never called.
+func TestSendWithRetry_RecordsMessageDeliveredByEditingPlaceholder(t *testing.T) {
+	ch := &sentRecorderChannel{sendIDs: []string{"11"}}
+	m, w := newSentRecorderManager(ch)
+	m.RecordPlaceholder("test", "123", "456")
+
+	m.sendWithRetry(context.Background(), "test", w,
+		testOutboundMessage(bus.OutboundMessage{Channel: "test", ChatID: "123", Content: "the answer"}))
+
+	if ch.sent != 0 || ch.editedMessages != 1 {
+		t.Fatalf("Send called %d times, placeholder edited %d times; want the placeholder edited only",
+			ch.sent, ch.editedMessages)
+	}
+	assertRecorded(t, ch, sentRecord{"123", "the answer", []string{"456"}})
+}
+
+func TestSendWithRetry_DoesNotRecordToolFeedbackOrUnidentifiedDelivery(t *testing.T) {
+	ch := &sentRecorderChannel{sendIDs: []string{"11"}}
+	m, w := newSentRecorderManager(ch)
+
+	toolFeedback := testOutboundMessage(bus.OutboundMessage{Channel: "test", ChatID: "123", Content: "running tool"})
+	toolFeedback.Context.Raw = map[string]string{"message_kind": "tool_feedback"}
+	m.sendWithRetry(context.Background(), "test", w, toolFeedback)
+
+	ch.sendIDs = nil
+	m.sendWithRetry(context.Background(), "test", w,
+		testOutboundMessage(bus.OutboundMessage{Channel: "test", ChatID: "123", Content: "no id reported"}))
+
+	assertRecorded(t, ch)
+	if ch.sent != 2 {
+		t.Fatalf("Send called %d times, want 2", ch.sent)
+	}
+}
+
+func TestSendMedia_RecordsDeliveredMedia(t *testing.T) {
+	ch := &sentRecorderChannel{mediaIDs: []string{"21"}}
+	m, _ := newSentRecorderManager(ch)
+
+	for _, parts := range [][]bus.MediaPart{
+		{{Type: "image", Ref: "media://a", Caption: "the glaze"}, {Type: "image", Ref: "media://b", Caption: "and its recipe"}},
+		{{Type: "image", Ref: "media://c"}},
+	} {
+		err := m.SendMedia(context.Background(), testOutboundMediaMessage(bus.OutboundMediaMessage{
+			Channel: "test",
+			ChatID:  "123",
+			Parts:   parts,
+		}))
+		if err != nil {
+			t.Fatalf("SendMedia() error = %v", err)
+		}
+	}
+
+	assertRecorded(t, ch,
+		sentRecord{"123", "the glaze\nand its recipe", []string{"21"}},
+		sentRecord{"123", "[image]", []string{"21"}},
+	)
+}
