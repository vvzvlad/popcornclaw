+	MentionOnly bool                `json:"mention_only,omitempty" yaml:"-"`
+	Prefixes    []string            `json:"prefixes,omitempty"     yaml:"-"`
+	Decision    GroupDecisionConfig `json:"decision,omitzero"      yaml:"decision,omitempty"`
+}
