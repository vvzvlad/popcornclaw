+package agent
+
+import (
+	"bytes"
+	"encoding/base64"
+	"image"
+	"image/jpeg"
+	"image/png"
+	"math/rand/v2"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A full-size screen capture must reach the model as a small JPEG, not as the 2 MB PNG that
+// made the provider answer 413 once a couple of them were in one turn.
+func TestEncodeImageToDataURLShrinksScreenCapture(t *testing.T) {
+	img := image.NewRGBA(image.Rect(0, 0, 1920, 1080))
+	rng := rand.New(rand.NewPCG(1, 2))
+	for i := range img.Pix {
+		img.Pix[i] = uint8(rng.IntN(256))
+	}
+	for i := 3; i < len(img.Pix); i += 4 {
+		img.Pix[i] = 255
+	}
+	path := filepath.Join(t.TempDir(), "screen.png")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := png.Encode(f, img); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got := encodeImageToDataURL(path, "image/png", info, 64<<20)
+
+	const prefix = "data:image/jpeg;base64,"
+	if !strings.HasPrefix(got, prefix) {
+		t.Fatalf("image was not re-encoded as JPEG, data URL starts with %.40q", got)
+	}
+	raw, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(got, prefix))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := jpeg.DecodeConfig(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Width != 1280 || cfg.Height != 720 {
+		t.Fatalf("shrunk to %dx%d, want 1280x720", cfg.Width, cfg.Height)
+	}
+	if int64(len(raw)) >= info.Size() {
+		t.Fatalf("JPEG is %d bytes, not smaller than the %d-byte PNG", len(raw), info.Size())
+	}
+}
