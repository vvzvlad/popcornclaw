index 00000000..778465d4
--- /dev/null
+++ b/pkg/channels/webhook/webhook_test.go
@@ -0,0 +1,421 @@
+package webhook
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/channels"
+	"github.com/sipeed/picoclaw/pkg/config"
+)
+
+const testSecret = "test-secret"
+
+func sign(secret string, body []byte) string {
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write(body)
+	return signaturePrefix + hex.EncodeToString(mac.Sum(nil))
+}
+
+func newTestChannel(t *testing.T, cfg *config.WebhookSettings) (*WebhookChannel, *bus.MessageBus) {
+	t.Helper()
+	mb := bus.NewMessageBus()
+	ch, err := NewWebhookChannel(&config.Channel{Enabled: true}, cfg, mb)
+	require.NoError(t, err)
+	require.NoError(t, ch.Start(context.Background()))
+	t.Cleanup(func() { _ = ch.Stop(context.Background()) })
+	return ch, mb
+}
+
+func TestNewWebhookChannel_Validation(t *testing.T) {
+	tests := []struct {
+		name      string
+		cfg       config.WebhookSettings
+		expectErr string
+	}{
+		{
+			name:      "missing secret",
+			cfg:       config.WebhookSettings{SendURL: "http://127.0.0.1/send"},
+			expectErr: "secret and send_url are required",
+		},
+		{
+			name:      "missing send_url",
+			cfg:       config.WebhookSettings{Secret: *config.NewSecureString(testSecret)},
+			expectErr: "secret and send_url are required",
+		},
+		{
+			name: "valid config",
+			cfg: config.WebhookSettings{
+				Secret:  *config.NewSecureString(testSecret),
+				SendURL: "http://127.0.0.1/send",
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := NewWebhookChannel(&config.Channel{Enabled: true}, &tt.cfg, bus.NewMessageBus())
+			if tt.expectErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.expectErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
+
+func TestWebhookPath(t *testing.T) {
+	tests := []struct {
+		name        string
+		channelName string
+		path        string
+		want        string
+	}{
+		{name: "default for type name", channelName: "webhook", want: "/webhook/webhook"},
+		{name: "default for instance name", channelName: "zakhar", want: "/webhook/zakhar"},
+		{name: "configured path", channelName: "zakhar", path: "/hooks/zakhar", want: "/hooks/zakhar"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ch, err := NewWebhookChannel(
+				&config.Channel{Enabled: true},
+				&config.WebhookSettings{
+					Path:    tt.path,
+					Secret:  *config.NewSecureString(testSecret),
+					SendURL: "http://127.0.0.1/send",
+				},
+				bus.NewMessageBus(),
+			)
+			require.NoError(t, err)
+			ch.SetName(tt.channelName)
+			assert.Equal(t, tt.want, ch.WebhookPath())
+		})
+	}
+}
+
+func TestWebhookHandler_Requests(t *testing.T) {
+	valid := []byte(`{"sender":"alice","content":"hello","thread_id":"t1"}`)
+
+	tests := []struct {
+		name      string
+		method    string
+		body      []byte
+		signature string
+		want      int
+	}{
+		{name: "valid signature", method: http.MethodPost, body: valid, signature: sign(testSecret, valid), want: 202},
+		{name: "wrong secret", method: http.MethodPost, body: valid, signature: sign("other", valid), want: 401},
+		{name: "missing signature", method: http.MethodPost, body: valid, want: 401},
+		{name: "missing prefix", method: http.MethodPost, body: valid, want: 401,
+			signature: strings.TrimPrefix(sign(testSecret, valid), signaturePrefix)},
+		{name: "signature is not hex", method: http.MethodPost, body: valid, signature: "sha256=zz", want: 401},
+		{name: "signature of another body", method: http.MethodPost, body: valid, want: 401,
+			signature: sign(testSecret, []byte(`{}`))},
+		{
+			name: "malformed json", method: http.MethodPost, want: 400,
+			body: []byte(`{"sender":`), signature: sign(testSecret, []byte(`{"sender":`)),
+		},
+		{
+			name: "empty content", method: http.MethodPost, want: 400,
+			body:      []byte(`{"sender":"alice","content":"  ","thread_id":"t1"}`),
+			signature: sign(testSecret, []byte(`{"sender":"alice","content":"  ","thread_id":"t1"}`)),
+		},
+		{
+			name: "no thread and no sender", method: http.MethodPost, want: 400,
+			body:      []byte(`{"content":"hello"}`),
+			signature: sign(testSecret, []byte(`{"content":"hello"}`)),
+		},
+		{
+			name: "no thread falls back to sender", method: http.MethodPost, want: 202,
+			body:      []byte(`{"sender":"alice","content":"hello"}`),
+			signature: sign(testSecret, []byte(`{"sender":"alice","content":"hello"}`)),
+		},
+		{name: "get not allowed", method: http.MethodGet, body: valid, signature: sign(testSecret, valid), want: 405},
+		{
+			name: "oversized body", method: http.MethodPost, want: 413,
+			body: bytes.Repeat([]byte("A"), maxWebhookBodySize+1),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ch, _ := newTestChannel(t, &config.WebhookSettings{
+				Secret:  *config.NewSecureString(testSecret),
+				SendURL: "http://127.0.0.1/send",
+			})
+
+			req := httptest.NewRequest(tt.method, "/webhook/webhook", bytes.NewReader(tt.body))
+			if tt.signature != "" {
+				req.Header.Set(signatureHeader, tt.signature)
+			}
+			rec := httptest.NewRecorder()
+
+			ch.ServeHTTP(rec, req)
+
+			assert.Equal(t, tt.want, rec.Code)
+		})
+	}
+}
