+func TestGroupDecision_ForumTopicsHaveSeparateHistories(t *testing.T) {
+	spy := &spyDecider{p: 0}
+	ch, _ := newGroupDecisionChannel(t, spy)
+
+	ch.RecordSentMessage(testGroupChatKey, &bus.InboundContext{TopicID: "100"}, "answer in topic A", []string{"101"})
+	if err := ch.handleMessage(context.Background(), newForumMessage(102, 100, 7, "in topic A")); err != nil {
+		t.Fatal(err)
+	}
+	if err := ch.handleMessage(context.Background(), newForumMessage(202, 200, 8, "in topic B")); err != nil {
+		t.Fatal(err)
+	}
+
+	if len(spy.requests) != 2 {
+		t.Fatalf("decider called %d times, want 2", len(spy.requests))
+	}
+	inA, inB := spy.requests[0], spy.requests[1]
+	if inA.BotLast == nil || inA.BotLast.Text != "answer in topic A" || len(inA.History) != 1 {
+		t.Errorf("topic A request = %+v, want the bot's message in its history", inA)
+	}
+	if inB.BotLast != nil || len(inB.History) != 0 {
+		t.Errorf("topic B request = %+v, want an empty history and no bot message", inB)
+	}
+}
+
+func TestGroupDecision_ReplyToForumTopicRootIsNotAReply(t *testing.T) {
+	spy := &spyDecider{p: 0}
+	ch, _ := newGroupDecisionChannel(t, spy)
+	botUser := &telego.User{ID: ch.bot.ID(), IsBot: true, Username: "testbot"}
+
+	// In a forum every message of topic 100 nominally replies to message 100, which opened the topic.
+	root := newForumMessage(105, 100, 7, "plain message in the topic")
+	root.ReplyToMessage = &telego.Message{MessageID: 100, From: botUser}
+	// A real reply to a message of the bot in the same topic.
+	real := newForumMessage(106, 100, 7, "a real reply")
+	real.ReplyToMessage = &telego.Message{MessageID: 101, From: botUser, Text: "bot answer"}
+	for _, msg := range []*telego.Message{root, real} {
+		if err := ch.handleMessage(context.Background(), msg); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	if len(spy.requests) != 2 {
+		t.Fatalf("decider called %d times, want 2", len(spy.requests))
+	}
+	if first := spy.requests[0]; first.RepliedTo != nil || first.RepliesToBot {
+		t.Errorf("reply to the topic root counted as a reply: %+v", first)
+	}
+	if second := spy.requests[1]; second.RepliedTo == nil || !second.RepliesToBot {
+		t.Errorf("real reply to the bot not seen: %+v", second)
+	}
+}
