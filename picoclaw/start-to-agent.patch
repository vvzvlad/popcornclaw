@@ -0,0 +1,19 @@
+package commands
+
+import (
+	"context"
+	"testing"
+)
+
+// /start goes to the agent, which greets in the language and role its workspace gives it.
+func TestBuiltinStartCommand_PassthroughsToAgentLogic(t *testing.T) {
+	ex := NewExecutor(NewRegistry(BuiltinDefinitions()), nil)
+	var reply string
+	res := ex.Execute(context.Background(), Request{
+		Text:  "/start",
+		Reply: func(text string) error { reply = text; return nil },
+	})
+	if res.Outcome != OutcomePassthrough || res.Command != "start" || reply != "" {
+		t.Fatalf("/start outcome=%v command=%q reply=%q, want a passthrough to the agent", res.Outcome, res.Command, reply)
+	}
+}
