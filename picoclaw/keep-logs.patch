+// errorBodyLimit bounds how much of an error body is read and logged.
+const errorBodyLimit = 4096
+
 // HandleErrorResponse reads a non-200 response body and returns an appropriate error.
 func HandleErrorResponse(resp *http.Response, apiBase string) error {
 	contentType := resp.Header.Get("Content-Type")
-	body, readErr := io.ReadAll(io.LimitReader(resp.Body, 256))
+	body, readErr := io.ReadAll(io.LimitReader(resp.Body, errorBodyLimit))
 	if readErr != nil {
 		return fmt.Errorf("failed to read response: %w", readErr)
 	}
+	// The error text keeps its 128-byte preview: retry and history-compaction
+	// decisions match substrings of it. The body, up to errorBodyLimit bytes,
+	// goes to the log only, so a provider error stays readable after the fact.
+	logger.WarnCF("provider", "Provider error response", map[string]any{
+		"status":   resp.StatusCode,
+		"api_base": apiBase,
+		"body":     string(body),
+	})
 	if LooksLikeHTML(body, contentType) {
 		return WrapHTMLResponseError(resp.StatusCode, body, contentType, apiBase)
 	}
