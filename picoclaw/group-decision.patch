+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGroupDecisionConfig_Defaults(t *testing.T) {
+	var d GroupDecisionConfig
+	assert.False(t, d.Enabled())
+	assert.InDelta(t, 0.5, d.Threshold(), 1e-9)
+	assert.Equal(t, 3*time.Second, d.Timeout())
+
+	d = GroupDecisionConfig{Model: "m", MinConfidence: 0.7, TimeoutMS: 1500}
+	assert.False(t, d.Enabled(), "model without api_key is not enough")
+	assert.InDelta(t, 0.7, d.Threshold(), 1e-9)
+	assert.Equal(t, 1500*time.Millisecond, d.Timeout())
+
+	d.APIKey = *NewSecureString("key")
+	assert.True(t, d.Enabled())
+	d.Model = ""
+	assert.False(t, d.Enabled(), "api_key without model is not enough")
+}
+
+func TestGroupDecisionConfig_APIKeyLivesInSecurityFile(t *testing.T) {
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "config.json")
+	require.NoError(t, os.WriteFile(configPath, []byte(`{
+  "version": 2,
+  "channels": {
+    "telegram": {
+      "enabled": true,
+      "type": "telegram",
+      "group_trigger": {
+        "mention_only": true,
+        "prefixes": ["!bot"],
+        "decision": {
+          "model": "typesafe/jev-1.14",
+          "min_confidence": 0.6,
+          "timeout_ms": 2000,
+          "proxy": "http://127.0.0.1:3128",
+          "bot_description": "does things",
+          "chat_description": "a group"
+        }
+      }
+    }
+  }
+}`), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, SecurityConfigFile), []byte(`channels:
+  telegram:
+    group_trigger:
+      decision:
+        api_key: "decision-key"
+`), 0o600))
+
+	cfg, err := LoadConfig(configPath)
+	require.NoError(t, err)
+	gt := cfg.Channels.Get("telegram").GroupTrigger
+	assert.True(t, gt.MentionOnly)
+	assert.Equal(t, []string{"!bot"}, gt.Prefixes)
+	assert.Equal(t, "typesafe/jev-1.14", gt.Decision.Model)
+	assert.Equal(t, "decision-key", gt.Decision.APIKey.String())
+	assert.Equal(t, "http://127.0.0.1:3128", gt.Decision.Proxy)
+	assert.True(t, gt.Decision.Enabled())
+	assert.Contains(t, cfg.Channels.Get("telegram").CollectSensitiveValues(), "decision-key")
+
+	savedPath := filepath.Join(t.TempDir(), "config.json")
+	require.NoError(t, SaveConfig(savedPath, cfg))
+
+	savedJSON, err := os.ReadFile(savedPath)
+	require.NoError(t, err)
+	assert.NotContains(t, string(savedJSON), "decision-key")
+	assert.Contains(t, string(savedJSON), "typesafe/jev-1.14")
+	savedSecurity, err := os.ReadFile(filepath.Join(filepath.Dir(savedPath), SecurityConfigFile))
+	require.NoError(t, err)
+	assert.Contains(t, string(savedSecurity), "decision-key")
+
+	reloaded, err := LoadConfig(savedPath)
+	require.NoError(t, err)
+	assert.Equal(t, cfg.Channels.Get("telegram").GroupTrigger, reloaded.Channels.Get("telegram").GroupTrigger)
+}
