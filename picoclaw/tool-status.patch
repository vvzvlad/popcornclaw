+package tools
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	"github.com/sipeed/picoclaw/pkg/providers"
+)
+
+const statusLoopStatus = "Проверяю, что статус не доходит до инструмента"
+
+// statusLoopProvider requests one tool call carrying the status argument, then
+// answers and records the history it was given on that last call.
+type statusLoopProvider struct {
+	calls   int
+	history []providers.Message
+}
+
+func (p *statusLoopProvider) Chat(
+	_ context.Context,
+	messages []providers.Message,
+	_ []providers.ToolDefinition,
+	_ string,
+	_ map[string]any,
+) (*providers.LLMResponse, error) {
+	p.calls++
+	if p.calls == 1 {
+		return &providers.LLMResponse{
+			ToolCalls: []providers.ToolCall{{
+				ID:   "call_status",
+				Type: "function",
+				Name: "status_recorder",
+				Arguments: map[string]any{
+					ToolStatusArg: statusLoopStatus,
+					"value":       "x",
+				},
+			}},
+		}, nil
+	}
+	p.history = messages
+	return &providers.LLMResponse{Content: "DONE"}, nil
+}
+
+func (p *statusLoopProvider) GetDefaultModel() string { return "status-loop-model" }
+
+// statusRecorderTool accepts extra arguments (additionalProperties: true; the
+// validator rejects unknown ones by default), so a leaked status reaches Execute
+// instead of failing validation.
+type statusRecorderTool struct {
+	mu   sync.Mutex
+	args map[string]any
+}
+
+func (t *statusRecorderTool) Name() string { return "status_recorder" }
+
+func (t *statusRecorderTool) Description() string { return "records its arguments" }
+
+func (t *statusRecorderTool) Parameters() map[string]any {
+	return map[string]any{
+		"type": "object",
+		"properties": map[string]any{
+			"value": map[string]any{"type": "string"},
+		},
+		"required":             []string{"value"},
+		"additionalProperties": true,
+	}
+}
+
+func (t *statusRecorderTool) Execute(_ context.Context, args map[string]any) *ToolResult {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.args = args
+	return NewToolResult("ok")
+}
+
+func TestRunToolLoop_StripsStatusBeforeToolExecution(t *testing.T) {
+	tool := &statusRecorderTool{}
+	registry := NewToolRegistry()
+	registry.Register(tool)
+	provider := &statusLoopProvider{}
+
+	result, err := RunToolLoop(
+		context.Background(),
+		ToolLoopConfig{
+			Provider:      provider,
+			Model:         "status-loop-model",
+			Tools:         registry,
+			MaxIterations: 3,
+		},
+		[]providers.Message{{Role: "user", Content: "do it"}},
+		"telegram",
+		"chat-1",
+	)
+	if err != nil {
+		t.Fatalf("RunToolLoop() error = %v", err)
+	}
+	if result.Content != "DONE" {
+		t.Fatalf("RunToolLoop() content = %q, want %q", result.Content, "DONE")
+	}
+
+	tool.mu.Lock()
+	args := tool.args
+	tool.mu.Unlock()
+	if args == nil {
+		t.Fatal("status_recorder was not executed")
+	}
+	if _, ok := args[ToolStatusArg]; ok {
+		t.Fatalf("tool args = %v, want %q stripped", args, ToolStatusArg)
+	}
+	if args["value"] != "x" {
+		t.Fatalf("tool args = %v, want value=x", args)
+	}
+
+	// Stripping works on a copy: the assistant message in history keeps the status.
+	var historyArgs map[string]any
+	for _, msg := range provider.history {
+		if msg.Role == "assistant" && len(msg.ToolCalls) == 1 {
+			historyArgs = msg.ToolCalls[0].Arguments
+		}
+	}
+	if historyArgs[ToolStatusArg] != statusLoopStatus {
+		t.Fatalf("assistant tool call args in history = %v, want %q kept", historyArgs, ToolStatusArg)
+	}
+}
